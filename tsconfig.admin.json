{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "server/admin/**/*.ts",
    "server/admin/app/**/*.vue",
    "server/admin/public/**/*.js",
    "tests/unit/admin-*.spec.ts",
    "tests/unit/admin-ui/**/*.ts",
    "tests/unit/admin-ui/**/*.vue",
    "vite.admin.config.ts"
  ],
  "exclude": ["server/admin/dist", "server/admin/src"]
}
