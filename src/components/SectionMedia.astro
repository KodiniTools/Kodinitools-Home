---
// Austauschbares Medium (Video ODER Bild), gesteuert über den Adminbereich
// (media.json). Rendert je nach Dateiendung ein <video> oder ein <img>.
//
// eager=true  -> sofort sichtbares Medium (autoplay bei Video, eager-Bild)
// eager=false -> unterhalb des Sichtbereichs (lazy: erst beim Scrollen laden)
// priority=true -> Bild mit fetchpriority="high" (LCP-Kandidat im Hero)
// width/height -> Pixelmaße des Bildes: width/height-Attribute + aspect-ratio,
//                 damit der Platz vor dem Laden reserviert ist (CLS)
// wrapperClass/mediaClass -> Styling-Haken (Sektions-Video vs. Hero-Banner)
// Leerer src -> es wird NICHTS gerendert.
interface Props {
  src: string;
  eager?: boolean;
  priority?: boolean;
  width?: number;
  height?: number;
  alt?: string;
  wrapperClass?: string;
  wrapperStyle?: string;
  mediaClass?: string;
}
const {
  src,
  eager = false,
  priority = false,
  width,
  height,
  alt = '',
  wrapperClass = 'section-video-wrapper',
  wrapperStyle = '',
  mediaClass = 'section-video',
} = Astro.props;

const ext = (src.split('?')[0].split('.').pop() || '').toLowerCase();
const VIDEO_EXT = ['mp4', 'webm', 'mov', 'm4v', 'ogv'];
const isVideo = VIDEO_EXT.includes(ext);
const VIDEO_MIME: Record<string, string> = {
  mp4: 'video/mp4',
  webm: 'video/webm',
  mov: 'video/quicktime',
  m4v: 'video/mp4',
  ogv: 'video/ogg',
};
const mime = VIDEO_MIME[ext] || 'video/mp4';
const hasSize = !!width && !!height && width > 0 && height > 0;
// aspect-ratio „auto W / H": gilt für die Inhaltsbox (Rahmen kommt dazu) und wird
// nach dem Laden durch das echte Seitenverhältnis ersetzt. --media-ar/--media-w:
// Seitenverhältnis und natürliche Breite für die Größenberechnung in CSS
// (siehe .hero-banner in hero.css).
const sizeStyle = hasSize
  ? `aspect-ratio:auto ${width} / ${height};--media-ar:${(width! / height!).toFixed(4)};--media-w:${width}px`
  : undefined;
---

{
  src && (
    <div class={wrapperClass} style={wrapperStyle || undefined}>
      {isVideo ? (
        eager ? (
          <video autoplay muted loop playsinline preload="metadata" class={mediaClass}>
            <source src={src} type={mime} />
          </video>
        ) : (
          <video muted loop playsinline preload="none" class={`${mediaClass} lazy-video`}>
            <source src={src} type={mime} />
          </video>
        )
      ) : (
        <img
          src={src}
          alt={alt}
          class={mediaClass}
          width={hasSize ? width : undefined}
          height={hasSize ? height : undefined}
          style={sizeStyle}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      )}
    </div>
  )
}
