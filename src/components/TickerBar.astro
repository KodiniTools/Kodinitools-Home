---
// Laufband / Ticker unter der Navigation (Phase 3b).
// Inhalte kommen aus der Content-Schicht (src/content/ticker.*.json),
// werden vom Adminbereich gepflegt. Rendert NICHTS, wenn deaktiviert oder leer
// -> im aktuellen Auslieferungszustand unsichtbar (verhaltensneutral).
import { getTicker, type Locale } from '../content/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const ticker = getTicker(lang);
const items = Array.isArray(ticker.items) ? ticker.items.filter((i) => i && i.text) : [];
const show = ticker.enabled === true && items.length > 0;

// Geschwindigkeit -> gleichmäßige Scroll-Geschwindigkeit in Pixel/Sekunde.
// (Konstante Pixel-Geschwindigkeit statt fester Dauer -> läuft bei kurzem wie
// bei langem Text gleich flott, unabhängig von der Textmenge.)
const speeds = { slow: 40, normal: 70, fast: 120 } as const;
const pxPerSec = speeds[ticker.speed] ?? speeds.normal;

// Admin-Design (optional). Nur wenn aktiviert, überschreiben wir per Inline-Vars
// die Standardfarben/-größe — sonst bleibt das bisherige Aussehen (inkl. Dark Mode).
function hexToRgba(hex: string, opacityPct: number): string | null {
  const m = /^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.exec((hex || '').trim());
  if (!m) return null;
  let h = m[1];
  if (h.length === 3)
    h = h
      .split('')
      .map((c) => c + c)
      .join('');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  const a = Math.max(0, Math.min(100, Number.isFinite(opacityPct) ? opacityPct : 100)) / 100;
  return `rgba(${r}, ${g}, ${b}, ${a})`;
}

const s = ticker.style;
const styleVars: string[] = [];
if (s && s.enabled) {
  if (s.fontSize) styleVars.push(`--ticker-fs:${s.fontSize}px`);
  if (s.textColor) styleVars.push(`--ticker-fg:${s.textColor}`);
  const bg = s.bgColor ? hexToRgba(s.bgColor, s.bgOpacity ?? 100) : null;
  if (bg) styleVars.push(`--ticker-bg:${bg}`);
}
const tickerStyle = styleVars.length ? styleVars.join(';') : undefined;
---

{
  show && (
    <div
      class="ticker"
      role="region"
      aria-label={lang === 'en' ? 'Announcements' : 'Ankündigungen'}
      data-ticker
      data-ticker-speed={pxPerSec}
      style={tickerStyle}
    >
      <div class="ticker__viewport">
        <div class="ticker__track" data-ticker-track>
          {/* Eine "Gruppe" = ein vollständiger Durchlauf aller Einträge.
              Einzeldurchlauf: die Gruppe startet rechts außerhalb, läuft einmal
              komplett durch bis links raus, dann wieder von rechts. */}
          <div class="ticker__group" data-ticker-group>
            {items.map((item) => (
              <span class="ticker__item">
                {item.link ? (
                  <a class="ticker__link" href={item.link}>
                    {item.text}
                  </a>
                ) : (
                  <span class="ticker__text">{item.text}</span>
                )}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  )
}

<style>
  .ticker {
    --ticker-bg: #014f99;
    --ticker-fg: #ffffff;
    --ticker-sep: rgba(255, 255, 255, 0.4);
    width: 100%;
    background: var(--ticker-bg);
    color: var(--ticker-fg);
    overflow: hidden;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global([data-theme='dark']) .ticker {
    --ticker-bg: #111827;
    --ticker-fg: #e2e8f0;
    --ticker-sep: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .ticker__viewport {
    display: flex;
    overflow: hidden;
  }

  .ticker__track {
    display: flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    will-change: transform;
  }

  /* Animation läuft erst, wenn der Client Breite von Streifen und Sichtbereich
     vermessen und Start/Ende + Dauer gesetzt hat -> gleichmäßige Geschwindigkeit
     und sauberer Ein-/Auslauf. */
  .ticker.is-ready .ticker__track {
    animation: ticker-scroll var(--ticker-duration, 20s) linear infinite;
  }

  /* Pausiert bei Hover/Focus, damit Links klickbar bleiben */
  .ticker:hover .ticker__track,
  .ticker:focus-within .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    padding: 8px 0;
    font-size: var(--ticker-fs, 0.9rem);
    font-weight: 500;
    line-height: 1.2;
  }

  /* Trennzeichen zwischen den Einträgen (nicht hinter dem letzten). */
  .ticker__item:not(:last-child)::after {
    content: '•';
    margin: 0 1.5rem;
    color: var(--ticker-sep);
  }

  .ticker__link {
    color: var(--ticker-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ticker__link:hover {
    opacity: 0.85;
  }
  .ticker__text {
    color: var(--ticker-fg);
  }

  /* Einzeldurchlauf: von rechts außerhalb (Sichtbreite) bis links komplett raus
     (eigene Breite nach links). Danach beginnt der Zyklus wieder rechts. */
  @keyframes ticker-scroll {
    from {
      transform: translateX(var(--ticker-start, 100vw));
    }
    to {
      transform: translateX(var(--ticker-end, -100%));
    }
  }

  /* Barrierefreiheit: keine Bewegung, wenn der Nutzer das wünscht */
  @media (prefers-reduced-motion: reduce) {
    .ticker.is-ready .ticker__track {
      animation: none;
    }
    .ticker__viewport {
      overflow-x: auto;
    }
  }
</style>

<script>
  // Progressive Enhancement: Streifen und Sichtbereich vermessen und die
  // Animation als Einzeldurchlauf mit konstanter Geschwindigkeit (px/s) starten.
  // Ein Durchlauf = Gruppe von rechts außerhalb bis links komplett raus; danach
  // erscheint sie wieder von rechts (ein Eintrag läuft einmal durch, dann der
  // nächste bzw. bei einem Eintrag wieder derselbe).
  function setupTicker(ticker: HTMLElement) {
    const track = ticker.querySelector<HTMLElement>('[data-ticker-track]');
    const group = ticker.querySelector<HTMLElement>('[data-ticker-group]');
    if (!track || !group) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      // Kein Scrollen gewünscht -> statisch anzeigen.
      ticker.classList.add('is-ready');
      return;
    }

    const pxPerSec = Number(ticker.getAttribute('data-ticker-speed')) || 70;

    const groupWidth = group.getBoundingClientRect().width;
    const viewport = ticker.getBoundingClientRect().width;
    if (groupWidth <= 0 || viewport <= 0) return; // noch nicht sichtbar/gerendert

    // Startpunkt: rechte Kante des Sichtbereichs. Endpunkt: Gruppe komplett
    // links draußen (um die eigene Breite nach links). Gesamtstrecke = beides.
    const travel = viewport + groupWidth;
    const duration = Math.max(4, travel / pxPerSec);

    ticker.style.setProperty('--ticker-start', `${viewport}px`);
    ticker.style.setProperty('--ticker-end', `-${groupWidth}px`);
    ticker.style.setProperty('--ticker-duration', `${duration}s`);
    ticker.classList.add('is-ready');
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-ticker]').forEach(setupTicker);
  }

  // Nach Layout/Fonts vermessen; bei Resize neu berechnen (entprellt).
  const start = () => requestAnimationFrame(init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(init).catch(() => {});
  }
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(init, 200);
  });
</script>
