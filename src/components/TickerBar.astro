---
// Laufband / Ticker unter der Navigation (Phase 3b).
// Inhalte kommen aus der Content-Schicht (src/content/ticker.*.json),
// werden vom Adminbereich gepflegt. Rendert NICHTS, wenn deaktiviert oder leer
// -> im aktuellen Auslieferungszustand unsichtbar (verhaltensneutral).
import { getTicker, type Locale } from '../content/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const ticker = getTicker(lang);
// Mehrzeiliger Eintragstext wird einzeilig dargestellt: Zeilenumbrüche werden zu
// Leerzeichen. So darf im Admin mehrzeilig getippt werden, das Laufband bleibt
// aber eine durchlaufende Zeile.
const oneLine = (t: string): string => t.replace(/\s*[\r\n]+\s*/g, ' ');
const items = Array.isArray(ticker.items)
  ? ticker.items.filter((i) => i && i.text).map((i) => ({ ...i, text: oneLine(i.text) }))
  : [];
const show = ticker.enabled === true && items.length > 0;

// Geschwindigkeit -> gleichmäßige Scroll-Geschwindigkeit in Pixel/Sekunde.
// (Konstante Pixel-Geschwindigkeit statt fester Dauer -> läuft bei kurzem wie
// bei langem Text gleich flott, unabhängig von der Textmenge.)
const speeds = { slow: 40, normal: 70, fast: 120 } as const;
const pxPerSec = speeds[ticker.speed] ?? speeds.normal;

// Admin-Design (optional). Nur wenn aktiviert, überschreiben wir per Inline-Vars
// die Standardfarben/-größe — sonst bleibt das bisherige Aussehen (inkl. Dark Mode).
function hexToRgba(hex: string, opacityPct: number): string | null {
  const m = /^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.exec((hex || '').trim());
  if (!m) return null;
  let h = m[1];
  if (h.length === 3)
    h = h
      .split('')
      .map((c) => c + c)
      .join('');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  const a = Math.max(0, Math.min(100, Number.isFinite(opacityPct) ? opacityPct : 100)) / 100;
  return `rgba(${r}, ${g}, ${b}, ${a})`;
}

// Eigene Schrift (optional): der Admin wählt einen Dateinamen aus /fonts. Wir
// erzeugen dafür eine @font-face-Regel und setzen die Schrift per CSS-Variable.
function fontFormat(file: string): string {
  const ext = (file.split('.').pop() || '').toLowerCase();
  return { woff2: 'woff2', woff: 'woff', ttf: 'truetype', otf: 'opentype' }[ext] ?? '';
}
// Dateiname -> eindeutiger, CSS-sicherer Family-Name.
function fontFamilyId(file: string): string {
  return 'ticker-font-' + file.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9]+/g, '-');
}
const VALID_FONT = /^[a-zA-Z0-9][a-zA-Z0-9._ -]*\.(woff2|woff|ttf|otf)$/i;

// Inline-Links im Text: [Wort](/pfad/) oder [Wort](https://…) machen nur dieses
// Wort zum Link. Andere/ungültige URLs bleiben unveränderter Literaltext (sicher
// gegen javascript: & Co.). Rückgabe: Segmente aus Text bzw. Text+Link.
function parseInline(text: string): { text: string; href?: string }[] {
  const parts: { text: string; href?: string }[] = [];
  const re = /\[([^\]]+)\]\(([^)\s]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) parts.push({ text: text.slice(last, m.index) });
    const [full, label, url] = m;
    if (/^(\/[^\s]*|https?:\/\/[^\s]+)$/.test(url)) parts.push({ text: label, href: url });
    else parts.push({ text: full });
    last = m.index + full.length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
}
const isExternal = (u: string) => /^https?:\/\//i.test(u);

const s = ticker.style;
// Geteilte Typografie kommt als Inline-Style (theme-unabhängig). Die Farben je
// Modus kommen als eigener <style>-Block, der über einen id-Selektor gescopt ist –
// so lässt sich der Dunkelmodus getrennt setzen (Inline-Style könnte das nicht).
const styleVars: string[] = [];
let fontFace: string | undefined;
let colorCss: string | undefined;
const tickerId = `ticker-${lang}`;
if (s && s.enabled) {
  if (s.fontSize) styleVars.push(`--ticker-fs:${s.fontSize}px`);
  if (typeof s.letterSpacing === 'number') styleVars.push(`--ticker-ls:${s.letterSpacing}px`);
  const font = typeof s.fontFamily === 'string' ? s.fontFamily.trim() : '';
  if (font && VALID_FONT.test(font)) {
    const fam = fontFamilyId(font);
    const fmt = fontFormat(font);
    const src = `url("/fonts/${encodeURIComponent(font)}")${fmt ? ` format("${fmt}")` : ''}`;
    fontFace = `@font-face{font-family:"${fam}";src:${src};font-display:swap;}`;
    styleVars.push(`--ticker-ff:"${fam}", system-ui, sans-serif`);
  }
  const colorVars = (c: { textColor: string; bgColor: string; bgOpacity: number }): string => {
    const parts: string[] = [];
    if (c.textColor) parts.push(`--ticker-fg:${c.textColor}`);
    const bg = c.bgColor ? hexToRgba(c.bgColor, c.bgOpacity ?? 100) : null;
    if (bg) parts.push(`--ticker-bg:${bg}`);
    return parts.join(';');
  };
  const lightVars = colorVars(s.light);
  const darkVars = colorVars(s.dark);
  const rules: string[] = [];
  // id-Selektor (Spezifität 1,0,0) gewinnt gegen die Klassen-Defaults unten – in
  // beiden Modi; der Dunkel-Selektor (1,1,0) gewinnt zusätzlich im Dunkelmodus.
  if (lightVars) rules.push(`#${tickerId}{${lightVars}}`);
  if (darkVars) rules.push(`[data-theme="dark"] #${tickerId}{${darkVars}}`);
  colorCss = rules.join('');
}
const tickerStyle = styleVars.length ? styleVars.join(';') : undefined;
// @font-face + die modusabhängigen Farb-Regeln zusammen als globaler Style.
const headCss = [fontFace, colorCss].filter(Boolean).join('');
---

{headCss && <style is:global set:html={headCss} />}

{
  show && (
    <div
      class="ticker"
      id={tickerId}
      role="region"
      aria-label={lang === 'en' ? 'Announcements' : 'Ankündigungen'}
      data-ticker
      data-ticker-speed={pxPerSec}
      style={tickerStyle}
    >
      <div class="ticker__viewport">
        <div class="ticker__track" data-ticker-track>
          {/* Eine "Gruppe" = ein vollständiger Durchlauf aller Einträge.
              Einzeldurchlauf: die Gruppe startet rechts außerhalb, läuft einmal
              komplett durch bis links raus, dann wieder von rechts. */}
          <div class="ticker__group" data-ticker-group>
            {items.map((item) => {
              const parts = parseInline(item.text);
              const hasInline = parts.some((p) => p.href);
              return (
                <span class="ticker__item">
                  {item.link && !hasInline ? (
                    <a
                      class="ticker__link"
                      href={item.link}
                      target={isExternal(item.link) ? '_blank' : undefined}
                      rel={isExternal(item.link) ? 'noopener noreferrer' : undefined}
                    >
                      {item.text}
                    </a>
                  ) : (
                    <span class="ticker__text">
                      {parts.map((p) =>
                        p.href ? (
                          <a
                            class="ticker__link"
                            href={p.href}
                            target={isExternal(p.href) ? '_blank' : undefined}
                            rel={isExternal(p.href) ? 'noopener noreferrer' : undefined}
                          >
                            {p.text}
                          </a>
                        ) : (
                          p.text
                        ),
                      )}
                    </span>
                  )}
                </span>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  )
}

<style>
  .ticker {
    --ticker-bg: #014f99;
    --ticker-fg: #ffffff;
    --ticker-sep: rgba(255, 255, 255, 0.4);
    width: 100%;
    background: var(--ticker-bg);
    color: var(--ticker-fg);
    overflow: hidden;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global([data-theme='dark']) .ticker {
    --ticker-bg: #111827;
    --ticker-fg: #e2e8f0;
    --ticker-sep: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .ticker__viewport {
    display: flex;
    overflow: hidden;
  }

  .ticker__track {
    display: flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    will-change: transform;
  }

  /* Animation läuft erst, wenn der Client Breite von Streifen und Sichtbereich
     vermessen und Start/Ende + Dauer gesetzt hat -> gleichmäßige Geschwindigkeit
     und sauberer Ein-/Auslauf. */
  .ticker.is-ready .ticker__track {
    animation: ticker-scroll var(--ticker-duration, 20s) linear infinite;
  }

  /* Pausiert bei Hover/Focus, damit Links klickbar bleiben */
  .ticker:hover .ticker__track,
  .ticker:focus-within .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    padding: 8px 0;
    font-size: var(--ticker-fs, 0.9rem);
    font-family: var(--ticker-ff, inherit);
    letter-spacing: var(--ticker-ls, normal);
    font-weight: 500;
    line-height: 1.2;
  }

  /* Trennzeichen zwischen den Einträgen (nicht hinter dem letzten). */
  .ticker__item:not(:last-child)::after {
    content: '•';
    margin: 0 1.5rem;
    color: var(--ticker-sep);
  }

  .ticker__link {
    color: var(--ticker-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ticker__link:hover {
    opacity: 0.85;
  }
  .ticker__text {
    color: var(--ticker-fg);
  }

  /* Einzeldurchlauf: von rechts außerhalb (Sichtbreite) bis links komplett raus
     (eigene Breite nach links). Danach beginnt der Zyklus wieder rechts. */
  @keyframes ticker-scroll {
    from {
      transform: translateX(var(--ticker-start, 100vw));
    }
    to {
      transform: translateX(var(--ticker-end, -100%));
    }
  }

  /* Barrierefreiheit: keine Bewegung, wenn der Nutzer das wünscht */
  @media (prefers-reduced-motion: reduce) {
    .ticker.is-ready .ticker__track {
      animation: none;
    }
    .ticker__viewport {
      overflow-x: auto;
    }
  }
</style>

<script>
  // Progressive Enhancement: Streifen und Sichtbereich vermessen und die
  // Animation als Einzeldurchlauf mit konstanter Geschwindigkeit (px/s) starten.
  // Ein Durchlauf = Gruppe von rechts außerhalb bis links komplett raus; danach
  // erscheint sie wieder von rechts (ein Eintrag läuft einmal durch, dann der
  // nächste bzw. bei einem Eintrag wieder derselbe).
  function setupTicker(ticker: HTMLElement) {
    const track = ticker.querySelector<HTMLElement>('[data-ticker-track]');
    const group = ticker.querySelector<HTMLElement>('[data-ticker-group]');
    if (!track || !group) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      // Kein Scrollen gewünscht -> statisch anzeigen.
      ticker.classList.add('is-ready');
      return;
    }

    const pxPerSec = Number(ticker.getAttribute('data-ticker-speed')) || 70;

    const groupWidth = group.getBoundingClientRect().width;
    const viewport = ticker.getBoundingClientRect().width;
    if (groupWidth <= 0 || viewport <= 0) return; // noch nicht sichtbar/gerendert

    // Startpunkt: rechte Kante des Sichtbereichs. Endpunkt: Gruppe komplett
    // links draußen (um die eigene Breite nach links). Gesamtstrecke = beides.
    const travel = viewport + groupWidth;
    const duration = Math.max(4, travel / pxPerSec);

    ticker.style.setProperty('--ticker-start', `${viewport}px`);
    ticker.style.setProperty('--ticker-end', `-${groupWidth}px`);
    ticker.style.setProperty('--ticker-duration', `${duration}s`);
    ticker.classList.add('is-ready');
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-ticker]').forEach(setupTicker);
  }

  // Nach Layout/Fonts vermessen; bei Resize neu berechnen (entprellt).
  const start = () => requestAnimationFrame(init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(init).catch(() => {});
  }
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(init, 200);
  });
</script>
