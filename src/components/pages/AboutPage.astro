---
import GlobalNav from '../GlobalNav.astro';
import TickerBar from '../TickerBar.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteFont from '../SiteFont.astro';
import { alternates, HOME_LABEL, HOME_PATH, OG_LOCALE, SITE, type Lang } from '../../i18n/lang';
import {
  ABOUT_CAPTION,
  ABOUT_LOGO,
  ABOUT_PAGE,
  ABOUT_PATH,
  ABOUT_PERSON,
  ABOUT_PHOTO,
} from '../../i18n/about';

// „Über mich“ für /ueber-mich/ (de) und /en/about/ (en); die Routen in src/pages/ sind nur Hüllen.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ABOUT_PAGE[lang];
const pageUrl = `${SITE}${ABOUT_PATH[lang]}`;
const alt = alternates(ABOUT_PATH);
// Sprachumschalter der Navigation: Gegenstück dieser Seite statt Startseite.
const otherLangPath = ABOUT_PATH[lang === 'de' ? 'en' : 'de'];
const photoUrl = `${SITE}${ABOUT_PHOTO.src}`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  inLanguage: lang,
  mainEntity: {
    '@type': 'Person',
    name: ABOUT_PERSON,
    image: photoUrl,
    url: pageUrl,
  },
});
---

<!doctype html>
<html lang={lang} class="kt-a11y">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={lang} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="de" href={alt.de} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.xDefault} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:site_name" content="KodiniTools" />
    <meta property="og:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />

    <meta name="theme-color" content="#014f99" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <style>
      @import '../../styles/global.css';

      .about-main {
        min-height: calc(100vh - 140px);
        padding: 2rem 1rem 5rem;
      }

      .about-container {
        max-width: 860px;
        margin: 0 auto;
      }

      .about-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--text-muted, #4f6f8e);
        margin-bottom: 2rem;
      }

      .about-breadcrumb a {
        color: var(--primary-color, #014f99);
        text-decoration: none;
      }

      .about-breadcrumb a:hover {
        text-decoration: underline;
      }

      /* Content panel: keeps text readable on the animated global background (watermark, grid) */
      .about-content {
        display: grid;
        grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
        gap: clamp(1.25rem, 4vw, 2.25rem);
        align-items: start;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid var(--border-color, #d4c09a);
        border-radius: 1.1rem;
        padding: clamp(1.25rem, 4vw, 2.25rem);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      }

      [data-theme='dark'] .about-content {
        background: rgba(14, 28, 50, 0.92);
      }

      .about-figure {
        margin: 0;
      }

      .about-caption {
        margin-top: 0.6rem;
        text-align: center;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-color, #003971);
      }

      [data-theme='dark'] .about-caption {
        color: var(--text-color, #f9f2d5);
      }

      /* Das Porträt ist freigestellt (transparent): die Kachel liefert den Hintergrund in beiden Themes. */
      .about-photo {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 1rem;
        border: 1px solid var(--border-color, #d4c09a);
        background: linear-gradient(160deg, #eef2f7 0%, #d9e4f1 100%);
      }

      [data-theme='dark'] .about-photo {
        background: linear-gradient(160deg, #24364f 0%, #16233a 100%);
      }

      .about-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin: 0 0 1.25rem;
      }

      .about-logo {
        flex: none;
        width: 3.5rem;
        height: 3.5rem;
      }

      .about-text h1 {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 800;
        color: var(--primary-color, #014f99);
        margin: 0;
        line-height: 1.2;
      }

      [data-theme='dark'] .about-text h1 {
        color: #f8e1a9;
      }

      .about-text p {
        font-size: 1rem;
        line-height: 1.75;
        color: var(--text-color, #003971);
        margin: 0 0 1rem;
      }

      .about-text p:last-child {
        margin-bottom: 0;
      }

      [data-theme='dark'] .about-text p {
        color: var(--text-color, #f9f2d5);
      }

      .about-back {
        margin-top: 3rem;
        text-align: center;
      }

      .about-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.4rem;
        /* Dunkelgold mit weisser Schrift in beiden Themes (Kontrast ≥ 5:1). */
        background: linear-gradient(135deg, #8f6620 0%, #6f4e14 100%);
        color: #ffffff;
        text-decoration: none;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.88rem;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
        box-shadow: 0 4px 15px rgba(111, 78, 20, 0.35);
      }

      .about-back-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
      }

      @media (max-width: 640px) {
        .about-main {
          padding: 1.5rem 0.75rem 3rem;
        }
        .about-content {
          grid-template-columns: minmax(0, 1fr);
          padding: 1rem 0.9rem;
          border-radius: 0.9rem;
        }
        .about-figure {
          max-width: 200px;
          margin: 0 auto;
        }
        .about-logo {
          width: 2.75rem;
          height: 2.75rem;
        }
      }
    </style>
    <SiteFont />
  </head>
  <body>
    <div class="global-background" aria-hidden="true">
      <div class="global-gradient"></div>
      <div class="global-noise"></div>
    </div>

    <GlobalNav lang={lang} altHref={otherLangPath} />
    <TickerBar lang={lang} />

    <main class="about-main">
      <div class="about-container">
        <nav class="about-breadcrumb" aria-label="Breadcrumb">
          <a href={HOME_PATH[lang]}>{HOME_LABEL[lang]}</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{t.breadcrumb}</span>
        </nav>

        <div class="about-content">
          <figure class="about-figure">
            <img
              class="about-photo"
              src={ABOUT_PHOTO.src}
              width={ABOUT_PHOTO.width}
              height={ABOUT_PHOTO.height}
              alt={t.photoAlt}
              decoding="async"
            />
            <figcaption class="about-caption">{ABOUT_CAPTION}</figcaption>
          </figure>

          <div class="about-text">
            <div class="about-heading">
              {/* Dekorativ: der Markenname steht in der Überschrift daneben. */}
              <img
                class="about-logo"
                src={ABOUT_LOGO.src}
                width={ABOUT_LOGO.width}
                height={ABOUT_LOGO.height}
                alt=""
                decoding="async"
              />
              <h1>{t.heading}</h1>
            </div>
            {t.paragraphs.map((text) => <p>{text}</p>)}
          </div>
        </div>

        <div class="about-back">
          <a href={HOME_PATH[lang]} class="about-back-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
            </svg>
            {t.back}
          </a>
        </div>
      </div>
    </main>

    <SiteFooter lang={lang} />

    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </body>
</html>
