---
import GlobalNav from '../GlobalNav.astro'
import TickerBar from '../TickerBar.astro'
import SiteFooter from '../SiteFooter.astro'
import SiteFont from '../SiteFont.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'
import { alternates, HOME_LABEL, HOME_PATH, OG_LOCALE, SITE, type Lang } from '../../i18n/lang'
import { CONTACT_URL, IMPRINT_OPERATOR, IMPRINT_PAGE, IMPRINT_PATH, PRIVACY_URL } from '../../i18n/imprint'

// Impressum für /impressum/ (de) und /en/legal-notice/ (en); die Routen in src/pages/ sind nur Hüllen.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = IMPRINT_PAGE[lang]
const op = IMPRINT_OPERATOR
const pageUrl = `${SITE}${IMPRINT_PATH[lang]}`
const alt = alternates(IMPRINT_PATH)

const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')
---


<!DOCTYPE html>
<html lang={lang} class="kt-a11y">
<head>
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);} // eslint-disable-line prefer-rest-params -- offizielles Google-Snippet, arguments bewusst
  gtag('consent', 'default', {
    'ad_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied',
    'analytics_storage': 'denied', 'functionality_storage': 'denied',
    'personalization_storage': 'denied', 'security_storage': 'granted', 'wait_for_update': 500
  });
  (function() {
    try {
      const c = JSON.parse(localStorage.getItem('cookieConsent') || '{}');
      if (c.analytics) gtag('consent', 'update', { 'analytics_storage': 'granted', 'functionality_storage': 'granted', 'personalization_storage': 'granted' });
      if (c.marketing) gtag('consent', 'update', { 'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted' });
    } catch { /* Consent optional – Fehler bewusst ignorieren */ }
  })();
  </script>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T7NS656K');</script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <meta name="robots" content="index, follow" />
  <meta name="language" content={lang} />
  <link rel="canonical" href={pageUrl} />
  <link rel="alternate" hreflang="de" href={alt.de} />
  <link rel="alternate" hreflang="en" href={alt.en} />
  <link rel="alternate" hreflang="x-default" href={alt.xDefault} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta property="og:site_name" content="KodiniTools" />
  <meta property="og:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />

  <meta name="theme-color" content="#014f99" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <style>
    @import '../../styles/global.css';

    .imprint-main {
      min-height: calc(100vh - 140px);
      padding: 2rem 1rem 5rem;
    }

    .imprint-container {
      max-width: 760px;
      margin: 0 auto;
    }

    .imprint-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--text-muted, #4f6f8e);
      margin-bottom: 2rem;
    }

    .imprint-breadcrumb a {
      color: var(--primary-color, #014f99);
      text-decoration: none;
    }

    .imprint-breadcrumb a:hover { text-decoration: underline; }

    /* Content panel: keeps text readable on the animated global background (watermark, grid) */
    .imprint-content {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1.1rem;
      padding: clamp(1.25rem, 4vw, 2.25rem);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }

    [data-theme="dark"] .imprint-content {
      background: rgba(14, 28, 50, 0.92);
    }

    .imprint-header {
      margin-bottom: 2rem;
    }

    .imprint-header h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800;
      color: var(--primary-color, #014f99);
      margin: 0 0 0.5rem;
      line-height: 1.2;
    }

    [data-theme="dark"] .imprint-header h1 { color: #f8e1a9; }

    .imprint-content p.imprint-subtitle {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-secondary, #4f6f8e);
      margin: 0;
    }

    .imprint-content h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-color, #003971);
      margin: 2rem 0 0.75rem;
    }

    [data-theme="dark"] .imprint-content h2 { color: var(--text-color, #f9f2d5); }

    .imprint-content p,
    .imprint-content address {
      font-size: 0.92rem;
      font-style: normal;
      line-height: 1.75;
      color: var(--text-color, #003971);
      margin: 0 0 1rem;
    }

    [data-theme="dark"] .imprint-content p,
    [data-theme="dark"] .imprint-content address { color: var(--text-color, #f9f2d5); }

    .imprint-content a {
      color: var(--primary-color, #014f99);
      overflow-wrap: anywhere;
    }

    [data-theme="dark"] .imprint-content a { color: #f8e1a9; }

    /* Noch offene Angabe (Wert null in src/i18n/imprint.ts) */
    .imprint-placeholder {
      background: #fff3b0;
      color: #6b4e00;
      border: 1px dashed #c9984d;
      border-radius: 0.3rem;
      padding: 0 0.3rem;
      font-weight: 600;
    }

    .imprint-back {
      margin-top: 3rem;
      text-align: center;
    }

    .imprint-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.4rem;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      color: #ffffff;
      text-decoration: none;
      border-radius: 0.75rem;
      font-weight: 600;
      font-size: 0.88rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 15px rgba(1, 79, 153, 0.3);
    }

    [data-theme="dark"] .imprint-back-btn {
      background: linear-gradient(135deg, #c9984d 0%, #a67d3d 100%);
      color: #091428;
    }

    .imprint-back-btn:hover {
      transform: translateY(-2px);
      text-decoration: none;
    }

    @media (max-width: 600px) {
      .imprint-main { padding: 1.5rem 0.75rem 3rem; }
      .imprint-content { padding: 1rem 0.9rem; border-radius: 0.9rem; }
    }
  </style>
  <SiteFont />
</head>
<body>
  <div class="global-background" aria-hidden="true">
    <div class="global-gradient"></div>
    <div class="global-noise"></div>
  </div>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T7NS656K" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <GlobalNav lang={lang} />
  <TickerBar lang={lang} />

  <main class="imprint-main">
    <div class="imprint-container">

      <nav class="imprint-breadcrumb" aria-label="Breadcrumb">
        <a href={HOME_PATH[lang]}>{HOME_LABEL[lang]}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{t.breadcrumb}</span>
      </nav>

      <div class="imprint-content">

        <header class="imprint-header">
          <h1>{t.heading}</h1>
          <p class="imprint-subtitle">{t.subtitle}</p>
        </header>

        <h2>{t.operatorHeading}</h2>
        <address>
          {op.name}<br />
          {op.brand}<br />
          {op.street ?? <mark class="imprint-placeholder">[{t.placeholder.street}]</mark>}<br />
          {op.postalCode ?? <mark class="imprint-placeholder">[{t.placeholder.postalCode}]</mark>} {op.city}<br />
          {t.country}
        </address>

        <h2>{t.contactHeading}</h2>
        <p>
          {t.emailLabel}: <a href={`mailto:${op.email}`}>{op.email}</a><br />
          {t.contactFormLabel}: <a href={CONTACT_URL}>{t.contactFormText}</a>
        </p>

        <h2>{t.uidHeading}</h2>
        <p>{op.uid ?? <mark class="imprint-placeholder">[{t.placeholder.uid}]</mark>}</p>

        <h2>{t.responsibleHeading}</h2>
        <p>{op.name}, {op.city}. {t.responsibleNote}</p>

        {t.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((text) => <p>{text}</p>)}
          </>
        ))}

        <h2>{t.privacyHeading}</h2>
        <p>{t.privacyText} <a href={PRIVACY_URL}>{t.privacyLink}</a>.</p>

      </div>

      <div class="imprint-back">
        <a href={HOME_PATH[lang]} class="imprint-back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
          </svg>
          {t.back}
        </a>
      </div>

    </div>
  </main>

  <SiteFooter lang={lang} />
  <Fragment set:html={cookieBannerHtml} />

  <script is:inline>
  (function() {
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
  </script>
</body>
</html>
