                    <a href="https://kodinitools.com/playlist_generator/" class="global-nav-dropdown-item" role="menuitem">{c.playlistGenerator}</a>
                    <a href="https://kodinitools.com/playlistkonverter/" class="global-nav-dropdown-item" role="menuitem">{c.playlistConverter}</a>
                    <a href="https://kodinitools.com/alarmtool/" class="global-nav-dropdown-item" role="menuitem">{c.alarmTool}</a>
                    <a href="https://kodinitools.com/audionormalisierer/" class="global-nav-dropdown-item" role="menuitem">{c.audioNormalizer}</a>
                    <a href="https://kodinitools.com/visualizer/" class="global-nav-dropdown-item" role="menuitem">{c.visualizer}</a>
                    <a href="https://kodinitools.com/equaliser19/" class="global-nav-dropdown-item" role="menuitem">{c.equalizer19}</a>
