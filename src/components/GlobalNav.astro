</nav>

<script is:inline>
(function () {
  'use strict';

  var MENU_OPEN = document.querySelector('.global-nav-hamburger')?.getAttribute('aria-label') || 'Menü öffnen';
  var MENU_CLOSE = document.querySelector('.global-nav-hamburger')?.getAttribute('aria-label') === 'Open menu'
    ? 'Close menu' : 'Menü schliessen';

  function initThemeSwitcher() {
    var themeBtns = document.querySelectorAll('.global-nav-theme-toggle');
    var themeIcons = document.querySelectorAll('.global-nav-theme-icon');
    if (!themeBtns.length) return;

    var savedTheme = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var currentTheme = savedTheme || (prefersDark ? 'dark' : 'light');
    applyTheme(currentTheme);

    themeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme') || 'light';
        var newTheme = current === 'light' ? 'dark' : 'light';
        applyTheme(newTheme);
        localStorage.setItem('theme', newTheme);
      });
    });

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      themeIcons.forEach(function (icon) {
        icon.textContent = theme === 'light' ? '🌙' : '☀️';
      });
    }
  }

  function initDropdowns() {
    var dropdowns = document.querySelectorAll('.global-nav-dropdown');

    dropdowns.forEach(function (dropdown) {
      var toggle = dropdown.querySelector('.global-nav-dropdown-toggle');
      var menu = dropdown.querySelector('.global-nav-dropdown-menu');

      function positionDropdown() {
        var rect = dropdown.getBoundingClientRect();
        var menuRect = menu.getBoundingClientRect();
        dropdown.classList.remove('flip-up', 'flip-right');
        if (rect.bottom + menuRect.height + 16 > window.innerHeight) dropdown.classList.add('flip-up');
        if (rect.left + menuRect.width > window.innerWidth) dropdown.classList.add('flip-right');
      }

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        dropdowns.forEach(function (other) {
          if (other !== dropdown) {
            other.classList.remove('active');
            other.querySelector('.global-nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
          }
        });
        if (!dropdown.classList.contains('active')) positionDropdown();
        var isActive = dropdown.classList.toggle('active');
        toggle.setAttribute('aria-expanded', String(isActive));
      });

      toggle.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle.click(); }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          dropdown.classList.add('active');
          toggle.setAttribute('aria-expanded', 'true');
          var first = menu.querySelector('.global-nav-dropdown-item');
          if (first) first.focus();
        }
      });

      var items = menu.querySelectorAll('.global-nav-dropdown-item');
      items.forEach(function (item, i) {
        item.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') { e.preventDefault(); (items[i + 1] || items[0]).focus(); }
          if (e.key === 'ArrowUp') { e.preventDefault(); (items[i - 1] || items[items.length - 1]).focus(); }
          if (e.key === 'Escape') {
            dropdown.classList.remove('active');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
      });
    });

    window.addEventListener('resize', function () {
      dropdowns.forEach(function (d) { if (d.classList.contains('active')) d.classList.remove('flip-up', 'flip-right'); });
    });

    var scrollTimeout;
    window.addEventListener('scroll', function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function () {
        dropdowns.forEach(function (d) {
          d.classList.remove('active');
          d.querySelector('.global-nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
      }, 150);
    });

    document.addEventListener('click', function () {
      dropdowns.forEach(function (d) {
        d.classList.remove('active');
        d.querySelector('.global-nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        dropdowns.forEach(function (d) {
          d.classList.remove('active');
          d.querySelector('.global-nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
        var hamburger = document.querySelector('.global-nav-hamburger');
        var navLinks = document.querySelector('.global-nav-links');
        if (hamburger && navLinks) {
          navLinks.classList.remove('is-open');
          hamburger.classList.remove('is-active');
          hamburger.setAttribute('aria-expanded', 'false');
          hamburger.setAttribute('aria-label', MENU_OPEN);
        }
      }
    });
  }

  function initMobileMenu() {
    var hamburger = document.querySelector('.global-nav-hamburger');
    var navLinks = document.querySelector('.global-nav-links');
    if (!hamburger || !navLinks) return;

    hamburger.addEventListener('click', function (e) {
      e.stopPropagation();
      var isOpen = navLinks.classList.toggle('is-open');
      hamburger.classList.toggle('is-active', isOpen);
      hamburger.setAttribute('aria-expanded', String(isOpen));
      hamburger.setAttribute('aria-label', isOpen ? MENU_CLOSE : MENU_OPEN);
    });

    navLinks.querySelectorAll('.global-nav-link, .global-nav-dropdown-item').forEach(function (link) {
      link.addEventListener('click', function () {
        navLinks.classList.remove('is-open');
        hamburger.classList.remove('is-active');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', MENU_OPEN);
      });
    });

    document.addEventListener('click', function (e) {
      if (!navLinks.contains(e.target) && !hamburger.contains(e.target)) {
        navLinks.classList.remove('is-open');
        hamburger.classList.remove('is-active');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', MENU_OPEN);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      initThemeSwitcher();
      initDropdowns();
      initMobileMenu();
    });
  } else {
    initThemeSwitcher();
    initDropdowns();
    initMobileMenu();
  }
})();
</script>
