---
interface Props {
  lang: 'de' | 'en'
}

const { lang } = Astro.props

const t = {
  de: {
    audioTools: 'Audiotools',
    imageTools: 'Bildtools',
    tools: 'Tools',
    contact: 'Kontakt',
    faq: 'FAQ',
    faqHref: '/faq/',
    mp3Converter: 'MP3 Konverter',
    audioEqualizer: 'Interaktiver Audio Equalizer',
    modernPlayer: 'Moderner Musikplayer',
    ultimatePlayer: 'Ultimativer Musikplayer',
    playlistGenerator: 'Audioplaylist Generator',
    playlistConverter: 'Playlist zu WebM Konverter',
    alarmTool: 'Alarmtool',
    audioNormalizer: 'Audio Normalizer',
    visualizer: 'Visualizer',
    equalizer19: '19-Band Equalizer',
    audioConverter: 'Audio Konverter',
    imageConverter: 'Bildkonverter',
    batchImageEditor: 'Bildserie bearbeiten',
    photoCollage: 'Fotocollage',
    colorExtractor: 'Kodini Farbextraktor',
    videoConverter: 'Videokonverter',
    ariaToggleTheme: 'Theme wechseln',
    ariaSelectLanguage: 'Sprache wählen',
    ariaMenuOpen: 'Menü öffnen',
    ariaMenuClose: 'Menü schliessen',
    ariaMainNav: 'Hauptnavigation',
    enHref: '/en/',
    deActive: true,
  },
  en: {
    audioTools: 'Audio Tools',
    imageTools: 'Image Tools',
    tools: 'Tools',
    contact: 'Contact',
    faq: 'FAQ',
    faqHref: '/en/faq/',
    mp3Converter: 'MP3 Converter',
    audioEqualizer: 'Interactive Audio Equalizer',
    modernPlayer: 'Modern Music Player',
    ultimatePlayer: 'Ultimate Music Player',
    playlistGenerator: 'Audio Playlist Generator',
    playlistConverter: 'Playlist to WebM Converter',
    alarmTool: 'Alarm Tool',
    audioNormalizer: 'Audio Normalizer',
    visualizer: 'Visualizer',
    equalizer19: '19-Band Equalizer',
    audioConverter: 'Audio Converter',
    imageConverter: 'Image Converter',
    batchImageEditor: 'Batch Image Editor',
    photoCollage: 'Photo Collage',
    colorExtractor: 'Kodini Color Extractor',
    videoConverter: 'Video Converter',
    ariaToggleTheme: 'Toggle theme',
    ariaSelectLanguage: 'Select language',
    ariaMenuOpen: 'Open menu',
    ariaMenuClose: 'Close menu',
    ariaMainNav: 'Main navigation',
    enHref: '/en/',
    deActive: false,
  },
} as const

const c = t[lang]
const deHref = '/'
---

<style>
.global-nav * {
    box-sizing: border-box;
}

body {
    padding-top: 0 !important;
}

html {
    scroll-padding-top: 0 !important;
}

.global-nav {
    --nav-bg: rgba(250, 250, 250, 0.92);
    --nav-text: #003971;
    --nav-text-hover: #001d3d;
    --nav-bg-hover: rgba(1, 79, 153, 0.06);
    --nav-border: rgba(1, 79, 153, 0.1);
    --nav-shadow: rgba(0, 57, 113, 0.08);
    --dropdown-bg: rgba(255, 255, 255, 0.97);
    --dropdown-border: rgba(1, 79, 153, 0.08);
    --dropdown-shadow: rgba(0, 57, 113, 0.12);
    --accent-color: #014f99;
}

[data-theme="dark"] .global-nav {
    --nav-bg: rgba(26, 32, 44, 0.9);
    --nav-text: #e2e8f0;
    --nav-text-hover: #f7fafc;
    --nav-bg-hover: rgba(255, 255, 255, 0.08);
    --nav-border: rgba(255, 255, 255, 0.1);
    --nav-shadow: rgba(0, 0, 0, 0.3);
    --dropdown-bg: rgba(45, 55, 72, 0.95);
    --dropdown-border: rgba(255, 255, 255, 0.1);
    --dropdown-shadow: rgba(0, 0, 0, 0.25);
    --accent-color: #6366f1;
    background: rgba(26, 32, 44, 0.9) !important;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.3);
}

[data-theme="dark"] .global-nav .global-nav-brand,
[data-theme="dark"] .global-nav .global-nav-link,
[data-theme="dark"] .global-nav .global-nav-dropdown-toggle,
[data-theme="dark"] .global-nav .global-nav-dropdown-item {
    color: #e2e8f0;
}

.global-nav {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--nav-border);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 1px 20px var(--nav-shadow);
}

.global-nav.sticky {
    position: sticky;
    top: 0;
}

.global-nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    height: 70px;
}

.global-nav-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--nav-text);
    text-decoration: none;
    transition: all 0.3s ease;
    letter-spacing: -0.025em;
    font-family: 'Supreme', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.brand-logo-icon {
    height: 24px;
    width: 24px;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.brand-flag-icon {
    height: 20px;
    width: 20px;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.global-nav-brand:hover {
    color: var(--accent-color);
    transform: scale(1.05);
}

.global-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Supreme', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.global-nav-item {
    position: relative;
}

.global-nav-link,
.global-nav-dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    color: var(--nav-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    background: transparent;
    border: none;
    white-space: nowrap;
}

.global-nav-link:hover,
.global-nav-dropdown-toggle:hover {
    color: var(--nav-text-hover);
    background: var(--nav-bg-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--nav-shadow);
}

.global-nav-dropdown-arrow {
    font-size: 0.7rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.7;
}

.global-nav-dropdown.active .global-nav-dropdown-arrow {
    transform: rotate(180deg);
}

.global-nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 280px;
    background: var(--dropdown-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--dropdown-border);
    border-radius: 12px;
    box-shadow: 0 10px 40px var(--dropdown-shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px) scale(0.95);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 8px 0;
    z-index: 200;
    max-height: 400px;
    overflow-y: auto;
}

.global-nav-dropdown.flip-up .global-nav-dropdown-menu {
    top: auto;
    bottom: calc(100% + 8px);
    transform: translateY(10px) scale(0.95);
}

.global-nav-dropdown.flip-up.active .global-nav-dropdown-menu {
    transform: translateY(0) scale(1);
}

.global-nav-dropdown.flip-right .global-nav-dropdown-menu {
    left: auto;
    right: 0;
}

.global-nav-dropdown.active .global-nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

.global-nav-dropdown-item {
    display: block;
    padding: 12px 20px;
    color: var(--nav-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
}

.global-nav-dropdown-item:hover {
    background: var(--nav-bg-hover);
    color: var(--nav-text-hover);
    border-left-color: var(--accent-color);
    padding-left: 24px;
}

.global-nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
    position: relative;
}

.global-nav-hamburger-line {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--nav-text);
    border-radius: 2px;
    transition: all 0.3s ease;
    position: absolute;
}

.global-nav-hamburger-line:nth-child(1) { top: 13px; }
.global-nav-hamburger-line:nth-child(2) { top: 20px; }
.global-nav-hamburger-line:nth-child(3) { top: 27px; }

.global-nav-hamburger.is-active .global-nav-hamburger-line:nth-child(1) {
    top: 20px;
    transform: rotate(45deg);
}

.global-nav-hamburger.is-active .global-nav-hamburger-line:nth-child(2) { opacity: 0; }

.global-nav-hamburger.is-active .global-nav-hamburger-line:nth-child(3) {
    top: 20px;
    transform: rotate(-45deg);
}

@media (max-width: 768px) {
    .global-nav-container {
        padding: 0 16px;
        height: 60px;
        position: relative;
    }

    .global-nav-brand { font-size: 1.3rem; }
    .brand-logo-icon { height: 22px; width: 22px; }
    .brand-flag-icon { height: 18px; width: 18px; }

    .global-nav-hamburger { display: flex; }

    .global-nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 0.25rem;
        width: 100%;
        text-align: center;
        background: var(--nav-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 1rem;
        border-radius: 0 0 1rem 1rem;
        box-shadow: 0 10px 40px var(--nav-shadow);
        z-index: 1000;
        max-height: 80vh;
        overflow-y: auto;
    }

    .global-nav-links.is-open { display: flex; }

    .global-nav-item { width: 100%; }

    .global-nav-link,
    .global-nav-dropdown-toggle {
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .global-nav-dropdown .global-nav-dropdown-menu {
        display: block;
        position: relative;
        top: 0;
        left: 0;
        width: 100%;
        min-width: unset;
        margin-top: 0.25rem;
        opacity: 1;
        visibility: visible;
        transform: none;
        box-shadow: none;
        background: rgba(0, 0, 0, 0.03);
        border-radius: 0.5rem;
        border: none;
        max-height: none;
    }

    [data-theme="dark"] .global-nav-dropdown .global-nav-dropdown-menu {
        background: rgba(255, 255, 255, 0.05);
    }

    .global-nav-dropdown-arrow { display: none; }

    .global-nav-dropdown-toggle {
        pointer-events: none;
        font-weight: 600;
    }

    .global-nav-dropdown-item {
        padding: 0.6rem 1rem 0.6rem 1.5rem;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: none;
    }

    .global-nav-dropdown-item:hover { padding-left: 1.5rem; }

    [data-theme="dark"] .global-nav-links { background: rgba(26, 32, 44, 0.95); }
    [data-theme="dark"] .global-nav-dropdown .global-nav-dropdown-menu { background: rgba(26, 32, 44, 0.95); }

    .global-nav-controls-desktop { display: none; }

    .global-nav-controls-mobile {
        display: flex;
        justify-content: center;
        margin: 0.5rem auto 0;
        padding-top: 0.75rem;
        border-top: 1px solid var(--nav-border);
    }
}

@supports not (backdrop-filter: blur(20px)) {
    .global-nav { background: rgba(250, 250, 250, 0.97); }
    [data-theme="dark"] .global-nav { background: rgba(26, 32, 44, 0.95); }
    .global-nav-dropdown-menu { background: var(--dropdown-bg); }
}

.global-nav-link:focus,
.global-nav-dropdown-toggle:focus {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
    border-radius: 8px;
}

.global-nav-dropdown-item:focus {
    background: var(--nav-bg-hover);
    outline: none;
    color: var(--accent-color);
}

.global-nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.global-nav-controls-desktop { display: flex; }
.global-nav-controls-mobile { display: none; }

.global-nav-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--nav-border);
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--nav-text);
    font-size: 1rem;
    line-height: 1;
}

.global-nav-theme-toggle:hover {
    background: var(--nav-bg-hover);
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);
}

.global-nav-theme-toggle:focus {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
}

.global-nav-theme-icon {
    display: block;
    font-size: 0.95rem;
    line-height: 1;
}

.global-nav-lang-switcher {
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--nav-border);
    border-radius: 0.5rem;
    padding: 0.25rem;
}

.global-nav-lang-btn {
    padding: 0.4rem 0.6rem;
    border: none;
    background: transparent;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--nav-text);
    font-family: 'Supreme', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
}

.global-nav-lang-btn:hover { background: var(--nav-bg-hover); }

.global-nav-lang-btn.active {
    background: var(--accent-color);
    color: #ffffff;
}

[data-theme="dark"] .global-nav-lang-btn.active { color: #0C0C10; }

@media (max-width: 768px) {
    .global-nav-lang-btn {
        padding: 0.3rem 0.5rem;
        font-size: 0.8rem;
    }
}
</style>

