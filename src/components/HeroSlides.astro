---
// Diashow-Container für den Hero-Bereich (Einzel-Banner oder Raster-Kachel).
// Das erste Medium kommt über den Slot (behält damit sein bisheriges Markup),
// weitere Bilder werden absolut darüber gelegt und per Script gewechselt.
// variant 'banner': Container in Größe des ersten Bildes (inline-block).
// variant 'cell':   Container füllt die Kachel; jedes weitere Bild bekommt den
//                   gleichen .hero-cell-media-Wrapper wie das erste (Bild-
//                   bearbeitung wirkt auf alle).
interface Props {
  slides: string[];
  settings: {
    interval?: number;
    duration?: number;
    transition?: string;
    pauseOnHover?: boolean;
    dots?: boolean;
  };
  variant: 'banner' | 'cell';
  offset?: number; // ms – versetzter Start (Kacheln nacheinander)
  total: number; // Anzahl aller Bilder inkl. dem ersten (für die Punkte)
}
const { slides, settings, variant, offset = 0, total } = Astro.props;
const interval = Math.max(1, Math.min(30, Number(settings.interval) || 5));
const duration = Math.max(
  0,
  Math.min(5000, Number.isFinite(Number(settings.duration)) ? Number(settings.duration) : 800),
);
const transition = ['fade', 'slide', 'zoom', 'none'].includes(settings.transition || '')
  ? settings.transition
  : 'fade';
const showDots = settings.dots !== false;
---

<div
  class={`hero-slides hero-slides--${transition} hero-slides--${variant}`}
  data-hero-slides
  data-interval={interval}
  data-pause={settings.pauseOnHover === false ? '0' : '1'}
  data-offset={Math.max(0, Math.round(offset))}
  style={`--slide-dur:${interval}s;--slide-fade:${duration}ms`}
>
  <slot />
  {
    slides.map((src) =>
      variant === 'cell' ? (
        <div class="hero-cell-media hero-slide">
          <img src={src} alt="" class="hero-grid-media" loading="lazy" decoding="async" />
        </div>
      ) : (
        <img src={src} alt="" class="hero-banner hero-slide" loading="lazy" decoding="async" />
      ),
    )
  }
  {
    showDots && (
      <div class="hero-slide-dots">
        {Array.from({ length: total }, (_, i) => (
          <span
            role="button"
            tabindex="0"
            class={`hero-slide-dot${i === 0 ? ' is-active' : ''}`}
            data-slide={i}
            aria-label={`Bild ${i + 1} von ${total}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  // Diashow: wechselt die Bilder im Intervall (optional versetzt gestartet),
  // Pause bei Hover; Punkte schalten direkt um und starten das Intervall neu.
  // Im Hintergrund-Tab wird angehalten.
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach((box) => {
    const slides = Array.from(
      box.querySelectorAll<HTMLElement>(':scope > .hero-slide, :scope > * > .hero-slide'),
    );
    if (slides.length < 2) return;
    const dots = Array.from(box.querySelectorAll<HTMLElement>('.hero-slide-dot'));
    const interval = Math.max(1, Number(box.dataset.interval) || 5) * 1000;
    const offset = Math.max(0, Number(box.dataset.offset) || 0);
    const pause = box.dataset.pause !== '0';
    let cur = 0;
    let timer: number | null = null;
    let delay: number | null = null;
    const show = (n: number) => {
      const next = ((n % slides.length) + slides.length) % slides.length;
      if (next === cur) return;
      slides.forEach((s) => s.classList.remove('is-prev'));
      slides[cur].classList.remove('is-active');
      slides[cur].classList.add('is-prev');
      dots[cur]?.classList.remove('is-active');
      cur = next;
      slides[cur].classList.add('is-active');
      dots[cur]?.classList.add('is-active');
    };
    const stop = () => {
      if (timer !== null) window.clearInterval(timer);
      if (delay !== null) window.clearTimeout(delay);
      timer = null;
      delay = null;
    };
    const start = (wait = 0) => {
      stop();
      const run = () => {
        delay = null;
        timer = window.setInterval(() => show(cur + 1), interval);
      };
      if (wait > 0) delay = window.setTimeout(run, wait);
      else run();
    };
    dots.forEach((d, n) => {
      const go = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        show(n);
        start();
      };
      d.addEventListener('click', go);
      d.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') go(e);
      });
    });
    if (pause) {
      box.addEventListener('mouseenter', stop);
      box.addEventListener('mouseleave', () => start());
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    start(offset);
  });
</script>
