---
import BaseLayout from '../layouts/BaseLayout.astro'
import GlobalNav from '../components/GlobalNav.astro'
import TickerBar from '../components/TickerBar.astro'
import SectionMedia from '../components/SectionMedia.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'
import { getContent, getMedia, HERO_LAYOUT_CELLS, effectiveHeroCellStyle, getTextStylesCss } from '../content/content'

// Inhalte aus der Content-Schicht (Standard-Locale + Admin-Overrides, gemergt).
const de = getContent('de')
const en = getContent('en')
const media = getMedia('de')

const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

// Type guard for tool entries (filters out sectionTitle, sectionDescription, processingBadge)
type ToolEntry = { title: string; description: string; badge: string; link: string; svg: string }
function isTool(val: unknown): val is ToolEntry {
  return typeof val === 'object' && val !== null && 'title' in val && 'link' in val
}

// Derive tool card arrays from de.json (single source of truth)
const audioTools = Object.entries(de.tools)
  .filter((e): e is [string, ToolEntry] => isTool(e[1]))
  .map(([k, t]) => ({ title: t.title, description: t.description, link: t.link, svg: t.svg, i18nKey: `tools.${k}`, badge: t.badge }))

const imageTools = Object.entries(de.imageTools)
  .filter((e): e is [string, ToolEntry] => isTool(e[1]))
  .map(([k, t]) => ({ title: t.title, description: t.description, link: t.link, svg: t.svg, i18nKey: `imageTools.${k}`, badge: t.badge }))

const diverseTools = Object.entries(de.diverseTools)
  .filter((e): e is [string, ToolEntry] => isTool(e[1]))
  .map(([k, t]) => ({ title: t.title, description: t.description, link: t.link, svg: t.svg, i18nKey: `diverseTools.${k}`, badge: t.badge }))

const features = Object.entries(de.hero.features).map(([k, text]) => ({
  text,
  i18nKey: `hero.features.${k}`,
}))

// Admin-Design des Hero-Bereichs -> Inline-CSS-Variablen (nur wenn aktiviert;
// sonst bleibt das Standard-Aussehen aus global.css, inkl. Dark Mode).
function heroHexToRgba(hex: string, opacityPct: number): string | null {
  const m = /^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.exec((hex || '').trim())
  if (!m) return null
  let h = m[1]
  if (h.length === 3) h = h.split('').map((c) => c + c).join('')
  const r = parseInt(h.slice(0, 2), 16)
  const g = parseInt(h.slice(2, 4), 16)
  const b = parseInt(h.slice(4, 6), 16)
  const a = Math.max(0, Math.min(100, Number.isFinite(opacityPct) ? opacityPct : 100)) / 100
  return `rgba(${r}, ${g}, ${b}, ${a})`
}
function heroSideVars(side: typeof media.heroDesign.light): string {
  const v: string[] = []
  const bg = heroHexToRgba(side.bgColor, side.bgOpacity)
  if (bg) v.push(`--hero-bg:${bg}`)
  if (side.borderColor) v.push(`--hero-border-color:${side.borderColor}`)
  v.push(`--hero-border-width:${side.borderWidth}px`)
  const cbg = heroHexToRgba(side.chipBgColor, side.chipBgOpacity)
  if (cbg) v.push(`--hero-chip-bg:${cbg}`)
  if (side.chipTextColor) v.push(`--hero-chip-text:${side.chipTextColor}`)
  const cbd = heroHexToRgba(side.chipBorderColor, side.chipBorderOpacity)
  if (cbd) v.push(`--hero-chip-border:${cbd}`)
  if (side.chipHoverBgColor) v.push(`--hero-chip-hover-bg:${side.chipHoverBgColor}`)
  if (side.chipHoverTextColor) v.push(`--hero-chip-hover-text:${side.chipHoverTextColor}`)
  if (side.ctaBgColor) v.push(`--hero-cta-bg:${side.ctaBgColor}`)
  if (side.ctaTextColor) v.push(`--hero-cta-text:${side.ctaTextColor}`)
  if (side.ctaHoverBgColor) v.push(`--hero-cta-hover-bg:${side.ctaHoverBgColor}`)
  if (side.ctaHoverTextColor) v.push(`--hero-cta-hover-text:${side.ctaHoverTextColor}`)
  if (side.titleTextColor) v.push(`--hero-title-color:${side.titleTextColor}`)
  return v.join(';')
}
// Eigene Hero-Schriften: Dateiname -> Family-Name, @font-face, gültige Endungen.
const VALID_FONT_FILE = /^[a-zA-Z0-9][a-zA-Z0-9._ -]*\.(woff2|woff|ttf|otf)$/i
function heroFontId(file: string): string {
  return 'kodini-font-' + file.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9]+/g, '-')
}
function heroFontFaceCss(file: string): string {
  const ext = (file.split('.').pop() || '').toLowerCase()
  const fmt = ({ woff2: 'woff2', woff: 'woff', ttf: 'truetype', otf: 'opentype' } as Record<string, string>)[ext] || ''
  const src = `url("/fonts/${encodeURIComponent(file)}")${fmt ? ` format("${fmt}")` : ''}`
  return `@font-face{font-family:"${heroFontId(file)}";src:${src};font-display:swap;}`
}
// Farben (getrennt Hell/Dunkel, nur wenn aktiviert) + eigene Schriften (immer,
// wenn gesetzt) als globales CSS für den Hero-Bereich.
function heroDesignCss(hd: typeof media.heroDesign): string | undefined {
  if (!hd) return undefined
  const faces: string[] = []
  const rules: string[] = []
  const fontVars: string[] = []
  const titleF = typeof hd.titleFont === 'string' ? hd.titleFont.trim() : ''
  const btnF = typeof hd.buttonFont === 'string' ? hd.buttonFont.trim() : ''
  if (titleF && VALID_FONT_FILE.test(titleF)) {
    faces.push(heroFontFaceCss(titleF))
    fontVars.push(`--hero-title-ff:"${heroFontId(titleF)}", system-ui, sans-serif`)
  }
  if (btnF && VALID_FONT_FILE.test(btnF)) {
    if (btnF !== titleF) faces.push(heroFontFaceCss(btnF))
    fontVars.push(`--hero-btn-ff:"${heroFontId(btnF)}", system-ui, sans-serif`)
  }
  // Typografie: Buchstabenabstand + Buchstaben-Kontur (Rahmen), für beide Modi.
  const numOr0 = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) ? v : 0)
  if (numOr0(hd.titleLetterSpacing) !== 0) fontVars.push(`--hero-title-ls:${hd.titleLetterSpacing}px`)
  if (numOr0(hd.buttonLetterSpacing) !== 0) fontVars.push(`--hero-btn-ls:${hd.buttonLetterSpacing}px`)
  if (numOr0(hd.titleStrokeWidth) > 0)
    fontVars.push(`--hero-title-stroke:${hd.titleStrokeWidth}px ${hd.titleStrokeColor}`)
  if (numOr0(hd.buttonStrokeWidth) > 0)
    fontVars.push(`--hero-btn-stroke:${hd.buttonStrokeWidth}px ${hd.buttonStrokeColor}`)
  if (numOr0(hd.titleFontSize) > 0) fontVars.push(`--hero-title-fs:${hd.titleFontSize}px`)
  if (numOr0(hd.subtitleFontSize) > 0) fontVars.push(`--hero-subtitle-fs:${hd.subtitleFontSize}px`)
  if (numOr0(hd.chipFontSize) > 0) fontVars.push(`--hero-chip-fs:${hd.chipFontSize}px`)
  if (numOr0(hd.ctaFontSize) > 0) fontVars.push(`--hero-cta-fs:${hd.ctaFontSize}px`)
  if (hd.enabled) {
    rules.push(`.hero{${heroSideVars(hd.light)}}`)
    rules.push(`[data-theme="dark"] .hero{${heroSideVars(hd.dark)}}`)
  }
  if (fontVars.length) rules.push(`.hero{${fontVars.join(';')}}`)
  const css = faces.join('') + rules.join('\n')
  return css || undefined
}
const heroCss = heroDesignCss(media.heroDesign)

// @font-face für die in Raster-Kacheln bzw. Banner verwendeten Textschriften.
const heroCellFontCss = [
  ...new Set(
    [
      ...(media.heroGridStyles || []).map((s) =>
        s && typeof s.font === 'string' ? s.font.trim() : '',
      ),
      typeof media.heroBannerFont === 'string' ? media.heroBannerFont.trim() : '',
    ].filter((f) => f && VALID_FONT_FILE.test(f)),
  ),
]
  .map(heroFontFaceCss)
  .join('')
// Größen/Farben einzelner Text-Slots aus dem „Texte"-Tab.
const textStylesCss = getTextStylesCss(media)
// Inline-Style des Text-Overlays: Farbe, freie Position (x/y in %), Größe, Schrift.
// Der Text wird an (x,y) verankert (Mittelpunkt) – frei per Maus im Admin gesetzt.
function textOverlayStyle(color: string, size: number, x: number, y: number, font: string): string {
  const p: string[] = []
  const cx = Math.max(0, Math.min(100, typeof x === 'number' ? x : 50))
  const cy = Math.max(0, Math.min(100, typeof y === 'number' ? y : 50))
  p.push(`left:${cx}%`)
  p.push(`top:${cy}%`)
  if (color) p.push(`color:${color}`)
  if (typeof size === 'number' && size > 0) p.push(`font-size:${size}px`)
  if (font && VALID_FONT_FILE.test(font)) p.push(`font-family:"${heroFontId(font)}", var(--site-font)`)
  return p.join(';')
}

// Build focused i18n map for vanilla JS (only keys used on this page)
const SKIP = new Set(['sectionTitle', 'sectionDescription', 'processingBadge'])

function buildPageMessages(locale: typeof de): Record<string, string> {
  const r: Record<string, string> = {}

  r['hero.title'] = locale.hero.title
  r['hero.subtitle'] = locale.hero.subtitle
  r['hero.cta'] = locale.hero.cta
  for (const [k, v] of Object.entries(locale.hero.features)) r[`hero.features.${k}`] = v
  for (const [k, v] of Object.entries(locale.search)) r[`search.${k}`] = v
  r['tool.open'] = locale.tool.open
  r['favorites.sectionTitle'] = locale.favorites.sectionTitle
  r['favorites.clearAll'] = locale.favorites.clearAll

  for (const section of ['tools', 'imageTools', 'diverseTools'] as const) {
    r[`${section}.sectionTitle`] = locale[section].sectionTitle
    for (const [k, entry] of Object.entries(locale[section])) {
      if (SKIP.has(k) || !isTool(entry)) continue
      r[`${section}.${k}.title`] = entry.title
      r[`${section}.${k}.description`] = entry.description
      r[`${section}.${k}.badge`] = entry.badge
      r[`${section}.${k}.svg`] = entry.svg
    }
  }

  return r
}

const pageI18n = {
  de: buildPageMessages(de),
  en: buildPageMessages(en as typeof de),
}
---

<BaseLayout>
  <div id="app">
    <!-- Global Background Effects -->
    <div class="global-background">
      <div class="global-gradient"></div>
      <div class="global-noise"></div>
      <div class="mouse-spotlight" id="mouseSpotlight"></div>
    </div>

    <!-- Navigation (SSI Partial) -->
    <GlobalNav lang="de" />
    <TickerBar lang="de" />

    <!-- Hero Section with Animated Mesh Gradient -->
    {heroCss && <style is:global set:html={heroCss} />}
    {heroCellFontCss && <style is:global set:html={heroCellFontCss} />}
    {textStylesCss && <style is:global set:html={textStylesCss} />}
    <section class="hero">
      <div class="mesh-gradient-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
        <div class="mesh-blob mesh-blob-4"></div>
      </div>
      <div class="noise-overlay"></div>

      <div class="hero-content">
        <div class="hero-promo">
          {media.heroMode === 'grid' ? (
            <div
              class={`hero-grid layout-${media.heroLayout}`}
              style={`--hero-cell-ratio:${({ '1:1': '1 / 1', '16:9': '16 / 9', '2:3': '2 / 3' })[media.heroGridRatio] || '1 / 1'};--hero-cell-fit:${media.heroGridFit === 'contain' ? 'contain' : 'cover'}`}
            >
              {media.heroGrid.slice(0, HERO_LAYOUT_CELLS[media.heroLayout] ?? 3).map((src, i) => {
                const link = (media.heroGridLinks && media.heroGridLinks[i]) || ''
                const ext = /^https?:\/\//i.test(link)
                const cs = media.heroGridStyles && media.heroGridStyles[i] ? effectiveHeroCellStyle(media, i) : null
                const cellStyle = cs
                  ? `--cell-bg:${heroHexToRgba(cs.bgColor, cs.bgOpacity) || 'transparent'};--cell-bw:${cs.borderWidth}px;--cell-bc:${cs.borderColor}`
                  : ''
                const cellClass = `hero-grid-cell${media.heroLayout === 'mosaic' && i === 0 ? ' hero-grid-cell--big' : ''}`
                // Kachel als Container: optionales Medium + optionaler Text-Overlay.
                // Leere Kachel bleibt als gestylte Box erhalten (Layout kollabiert nicht).
                const cellInner = (
                  <div class={cellClass} style={cellStyle}>
                    {src && (
                      <SectionMedia
                        src={src}
                        eager={true}
                        alt={`Bild ${i + 1}`}
                        wrapperClass="hero-cell-media"
                        mediaClass="hero-grid-media"
                      />
                    )}
                    {cs && cs.text && (
                      <div
                        class="hero-cell-text"
                        style={textOverlayStyle(cs.textColor, cs.textSize, cs.textX, cs.textY, cs.font)}
                      >
                        {cs.text}
                      </div>
                    )}
                  </div>
                )
                return link ? (
                  <a
                    class="hero-media-link"
                    href={link}
                    target={ext ? '_blank' : undefined}
                    rel={ext ? 'noopener noreferrer' : undefined}
                  >
                    {cellInner}
                  </a>
                ) : (
                  cellInner
                )
              })}
            </div>
          ) : media.heroBanner ? (
            media.heroBannerLink ? (
              <a
                class="hero-media-link"
                href={media.heroBannerLink}
                target={/^https?:\/\//i.test(media.heroBannerLink) ? '_blank' : undefined}
                rel={/^https?:\/\//i.test(media.heroBannerLink) ? 'noopener noreferrer' : undefined}
              >
                <div class="hero-banner-wrapper">
                  <SectionMedia
                    src={media.heroBanner}
                    eager={true}
                    alt="KodiniTools Banner"
                    wrapperClass="hero-banner-inner"
                    mediaClass="hero-banner"
                  />
                  {media.heroBannerText && (
                    <div class="hero-banner-text" style={textOverlayStyle(media.heroBannerTextColor, media.heroBannerTextSize, media.heroBannerTextX, media.heroBannerTextY, media.heroBannerFont)}>
                      {media.heroBannerText}
                    </div>
                  )}
                </div>
              </a>
            ) : (
              <div class="hero-banner-wrapper">
                <SectionMedia
                  src={media.heroBanner}
                  eager={true}
                  alt="KodiniTools Banner"
                  wrapperClass="hero-banner-inner"
                  mediaClass="hero-banner"
                />
                {media.heroBannerText && (
                  <div class="hero-banner-text" style={textOverlayStyle(media.heroBannerTextColor, media.heroBannerTextSize, media.heroBannerTextX, media.heroBannerTextY, media.heroBannerFont)}>
                    {media.heroBannerText}
                  </div>
                )}
              </div>
            )
          ) : media.heroBannerText ? (
            <div class="hero-banner-wrapper hero-banner-textonly">
              <div
                class="hero-banner-text hero-banner-text--static"
                style={textOverlayStyle(media.heroBannerTextColor, media.heroBannerTextSize, media.heroBannerTextX, media.heroBannerTextY, media.heroBannerFont)}
              >
                {media.heroBannerText}
              </div>
            </div>
          ) : null}
          <h1 class="hero-title typing-title">
            <span class="typed-text" id="typedText"></span>
          </h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">Sichere Bearbeitung - Im Browser oder auf unseren Servern<br/>Keine Installation, keine Anmeldung</p>
        </div>

        <!-- Features Grid -->
        <div class="features-grid">
          {features.map((feature) => (
            <div class="feature-card">
              <div class="feature-text" data-i18n={feature.i18nKey}>{feature.text}</div>
            </div>
          ))}
        </div>

        <!-- Hero CTA -->
        <div class="hero-cta-wrap">
          <a href="#audio-tools" class="hero-cta-btn" data-i18n="hero.cta">Jetzt starten</a>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="scroll-indicator" id="scrollIndicator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </section>

    <!-- Favorites Section (hidden until at least one favorite is saved) -->
    <section id="favoritesSection" class="tools-section favorites-section" style="display: none;">
      <div class="section-header">
        <h2 data-i18n="favorites.sectionTitle">Meine Favoriten</h2>
        <button id="favClearAll" class="fav-clear-btn" data-i18n="favorites.clearAll">Alle entfernen</button>
      </div>
      <div id="favoritesGrid" class="svg-card-grid"></div>
    </section>

    <!-- Audio Tools Section -->
    <section id="audio-tools" class="tools-section">
      <div class="section-header">
        <h2 data-i18n="tools.sectionTitle">Audio Tools</h2>
      </div>

      <SectionMedia src={media.sectionVideos.audio} eager={true} />

      <div class="svg-card-grid">
        {audioTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Zu Favoriten hinzufügen" title="Favorit">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Öffnen
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="imageTools.sectionTitle">Bild Tools</h2>
      </div>

      <SectionMedia src={media.sectionVideos.image} />

      <div class="svg-card-grid grid-centered">
        {imageTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Zu Favoriten hinzufügen" title="Favorit">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Öffnen
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Diverse Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="diverseTools.sectionTitle">Diverse Tools</h2>
      </div>

      <SectionMedia src={media.sectionVideos.diverse} />

      <div class="svg-card-grid grid-centered">
        {diverseTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Zu Favoriten hinzufügen" title="Favorit">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Öffnen
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Scroll to Top Button -->
    <button
      id="scrollToTop"
      class="scroll-to-top"
      aria-label="Nach oben scrollen"
      data-i18n-aria="search.scrollTop"
      style="display: none;"
    >
      &uarr;
    </button>

    <SiteFooter lang="de" />
    <Fragment set:html={cookieBannerHtml} />
    </div>

  <!-- Minimal Vanilla JS for interactivity -->
  <script is:inline define:vars={{ pageI18n }}>
  document.addEventListener('DOMContentLoaded', function() {
    // --- Page i18n ---
    var PAGE_I18N = pageI18n;

    // Wiederverwendbare Übersetzungsfunktion
    var pageT; // wird von applyPageTranslations gesetzt
    function applyPageTranslations() {
      var pageLang = 'de';
      pageT = PAGE_I18N[pageLang] || PAGE_I18N['de'];

      // Apply text translations
      document.querySelectorAll('#app [data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (pageT[key]) {
          var v = pageT[key];
          if (v.indexOf('\n') !== -1) {
            // Mehrzeilig: sicher escapen, dann Umbrüche als <br/> ausgeben.
            el.innerHTML = v
              .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
              .replace(/\n/g, '<br/>');
          } else {
            el.textContent = v;
          }
        }
      });

      // Apply placeholder translations
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (pageT[key]) el.placeholder = pageT[key];
      });

      // Apply aria-label translations
      document.querySelectorAll('#app [data-i18n-aria]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-aria');
        if (pageT[key]) el.setAttribute('aria-label', pageT[key]);
      });

      // Update SVG images on tool cards based on language
      document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
        var key = card.getAttribute('data-i18n-key');
        var svgPath = pageT[key + '.svg'];
        if (svgPath) {
          var img = card.querySelector('img');
          if (img && img.getAttribute('src') !== svgPath) {
            img.setAttribute('src', svgPath);
          }
          var titleText = pageT[key + '.title'];
          if (titleText && img) {
            img.setAttribute('alt', titleText);
          }
        }
        // Update data-title and data-description for search
        var titleKey = key + '.title';
        var descKey = key + '.description';
        if (pageT[titleKey]) {
          card.setAttribute('data-title', pageT[titleKey]);
          var titleEl = card.querySelector('.tool-card-title');
          if (titleEl) titleEl.textContent = pageT[titleKey];
        }
        if (pageT[descKey]) {
          card.setAttribute('data-description', pageT[descKey]);
          var descEl = card.querySelector('.tool-card-desc');
          if (descEl) descEl.textContent = pageT[descKey];
          var popupDescEl = card.querySelector('.tool-popup-desc');
          if (popupDescEl) popupDescEl.textContent = pageT[descKey];
        }
      });

      // Typing-Text aktualisieren (sofort, ohne Animation bei Sprachwechsel)
      var typedEl = document.getElementById('typedText');
      if (typedEl && typedEl.textContent.length > 0) {
        typedEl.textContent = pageT['hero.title'] || '';
      }
    }

    // Initial anwenden
    applyPageTranslations();

    // Live-Update bei Sprachwechsel (ohne Reload)
    window.addEventListener('locale-changed', applyPageTranslations);

    // --- Typing Animation ---
    var typedTextEl = document.getElementById('typedText');
    if (typedTextEl) {
      var fullTitle = pageT['hero.title'] || 'Kostenlose Online-Tools für Audio & Bild';
      var currentIndex = 0;
      function typeNextChar() {
        if (currentIndex < fullTitle.length) {
          typedTextEl.textContent += fullTitle[currentIndex];
          currentIndex++;
          setTimeout(typeNextChar, Math.random() * 50 + 50);
        }
      }
      setTimeout(typeNextChar, 500);
    }

    // --- Mouse Spotlight ---
    const spotlight = document.getElementById('mouseSpotlight');
    if (spotlight) {
      document.addEventListener('mousemove', function(e) {
        const xPct = (e.clientX / window.innerWidth) * 100;
        const yPct = (e.clientY / window.innerHeight) * 100;
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const color = isDark ? 'rgba(201, 152, 77, 0.15)' : 'rgba(1, 79, 153, 0.20)';
        spotlight.style.background = 'radial-gradient(1200px circle at ' + xPct + '% ' + yPct + '%, ' + color + ', transparent 45%)';
      });
    }

    // --- Scroll to Top ---
    // --- Scroll Indicator hide on scroll ---
    var scrollIndicator = document.getElementById('scrollIndicator');
    if (scrollIndicator) {
      scrollIndicator.addEventListener('click', function() {
        document.getElementById('audio-tools')?.scrollIntoView({ behavior: 'smooth' });
      });
    }

    var scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
      window.addEventListener('scroll', function() {
        scrollBtn.style.display = window.scrollY > 400 ? 'flex' : 'none';
        if (scrollIndicator) scrollIndicator.style.opacity = window.scrollY > 80 ? '0' : '0.7';
      }, { passive: true });

      scrollBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // --- 3D Tilt Effect for SVG Cards ---
    var isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    if (!isTouchDevice) {
      document.addEventListener('mousemove', function(e) {
        var target = e.target;
        if (!target || typeof target.closest !== 'function') return;
        var card = target.closest('.tool-card');
        if (!card) return;

        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / 18;
        var rotateY = (centerX - x) / 18;

        card.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateY(-5px)';
      });

      document.addEventListener('mouseout', function(e) {
        var target = e.target;
        var relatedTarget = e.relatedTarget;
        if (target && target.classList && target.classList.contains('tool-card') &&
            (!relatedTarget || !target.contains(relatedTarget))) {
          target.style.transform = '';
        }
      });
    }

    // --- Intersection Observer for Scroll Animations ---
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var parent = entry.target.parentElement;
          if (parent) {
            var siblings = Array.from(parent.children);
            var index = siblings.indexOf(entry.target);
            entry.target.style.transitionDelay = (index * 0.08) + 's';
          }
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.tools-section, .svg-card-link').forEach(function(el) {
      el.classList.add('scroll-reveal');
      observer.observe(el);
    });

    // --- Feature Card 3D Tilt ---
    if (!isTouchDevice) {
      var featuresGrid = document.querySelector('.features-grid');
      if (featuresGrid) {
        featuresGrid.addEventListener('mousemove', function(e) {
          var card = e.target.closest('.feature-card');
          if (!card) return;
          var rect = card.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          var rotateX = (y - rect.height / 2) / 12;
          var rotateY = (rect.width / 2 - x) / 12;
          card.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateY(-5px) scale(1.02)';
          card.style.setProperty('--feature-mouse-x', (x / rect.width * 100) + '%');
          card.style.setProperty('--feature-mouse-y', (y / rect.height * 100) + '%');
        });

        featuresGrid.addEventListener('mouseleave', function() {
          featuresGrid.querySelectorAll('.feature-card').forEach(function(card) {
            card.style.transform = '';
            card.style.setProperty('--feature-mouse-x', '50%');
            card.style.setProperty('--feature-mouse-y', '50%');
          });
        });

        featuresGrid.querySelectorAll('.feature-card').forEach(function(card) {
          card.addEventListener('mouseleave', function() {
            card.style.transform = '';
            card.style.setProperty('--feature-mouse-x', '50%');
            card.style.setProperty('--feature-mouse-y', '50%');
          });
        });
      }
    }

    // --- Favorites ---
    var FAV_KEY = 'kdt-favorites';

    function getFavorites() {
      try {
        var raw = JSON.parse(localStorage.getItem(FAV_KEY)) || [];
        // filter out legacy string-only entries from old format
        return raw.filter(function(f) { return f && typeof f === 'object' && f.key; });
      } catch(e) { return []; }
    }

    function saveFavorites(favs) {
      localStorage.setItem(FAV_KEY, JSON.stringify(favs));
    }

    function buildFavCard(item) {
      var a = document.createElement('a');
      a.href = item.link;
      a.className = 'svg-card-link';
      a.setAttribute('data-i18n-key', item.key);
      a.setAttribute('data-title', item.title);
      a.setAttribute('data-description', item.description);

      var card = document.createElement('div');
      card.className = 'tool-card';

      if (item.badge) {
        var badge = document.createElement('span');
        badge.className = 'tool-card-badge';
        badge.textContent = item.badge;
        card.appendChild(badge);
      }

      var h3 = document.createElement('h3');
      h3.className = 'tool-card-title';
      h3.textContent = item.title;
      card.appendChild(h3);

      var footer = document.createElement('div');
      footer.className = 'tool-card-footer';

      var favBtn = document.createElement('button');
      favBtn.className = 'fav-btn is-active';
      favBtn.setAttribute('aria-label', 'Aus Favoriten entfernen');
      favBtn.title = 'Favorit';
      favBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>';
      footer.appendChild(favBtn);

      var openSpan = document.createElement('span');
      openSpan.className = 'tool-card-open';
      openSpan.innerHTML = 'Öffnen <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
      footer.appendChild(openSpan);

      card.appendChild(footer);
      a.appendChild(card);

      var popup = document.createElement('div');
      popup.className = 'tool-popup';
      popup.setAttribute('role', 'tooltip');
      var popupDesc = document.createElement('p');
      popupDesc.className = 'tool-popup-desc';
      popupDesc.textContent = item.description;
      popup.appendChild(popupDesc);
      a.appendChild(popup);

      return a;
    }

    function renderFavorites() {
      var favs = getFavorites();
      var section = document.getElementById('favoritesSection');
      var grid = document.getElementById('favoritesGrid');
      if (!section || !grid) return;
      grid.innerHTML = '';
      if (favs.length === 0) {
        section.style.display = 'none';
        return;
      }
      section.style.display = 'block';
      favs.forEach(function(item) {
        var cardEl = buildFavCard(item);
        attachFavBtn(cardEl);
        grid.appendChild(cardEl);
      });
    }

    function updateAllFavButtons() {
      var favs = getFavorites();
      var favKeys = favs.map(function(f) { return f.key; });
      document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
        var key = card.getAttribute('data-i18n-key');
        var btn = card.querySelector('.fav-btn');
        if (!btn) return;
        var inFavSection = !!card.closest('#favoritesSection');
        btn.classList.toggle('is-active', inFavSection || favKeys.indexOf(key) !== -1);
      });
    }

    function toggleFavorite(key, btnEl, cardEl) {
      var favs = getFavorites();
      var idx = favs.findIndex(function(f) { return f.key === key; });
      if (idx === -1) {
        var badgeEl = cardEl ? cardEl.querySelector('.tool-card-badge') : null;
        favs.push({
          key: key,
          title: cardEl ? (cardEl.getAttribute('data-title') || '') : key,
          description: cardEl ? (cardEl.getAttribute('data-description') || '') : '',
          link: cardEl ? (cardEl.getAttribute('href') || '#') : '#',
          badge: badgeEl ? badgeEl.textContent : ''
        });
      } else {
        favs.splice(idx, 1);
      }
      saveFavorites(favs);
      if (btnEl) {
        btnEl.classList.add('pop');
        btnEl.addEventListener('animationend', function() { btnEl.classList.remove('pop'); }, { once: true });
      }
      renderFavorites();
      updateAllFavButtons();
    }

    function attachFavBtn(cardEl) {
      var btn = cardEl.querySelector('.fav-btn');
      if (!btn) return;
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var key = cardEl.getAttribute('data-i18n-key');
        toggleFavorite(key, btn, cardEl);
      });
    }

    document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
      attachFavBtn(card);
    });

    var favClearBtn = document.getElementById('favClearAll');
    if (favClearBtn) {
      favClearBtn.addEventListener('click', function() {
        saveFavorites([]);
        renderFavorites();
        updateAllFavButtons();
      });
    }

    renderFavorites();
    updateAllFavButtons();

    window.addEventListener('locale-changed', function() {
      renderFavorites();
      updateAllFavButtons();
    });
  });
  </script>

  <script>
    // Lazy-load videos below the fold via IntersectionObserver
    var lazyVideos = document.querySelectorAll('video.lazy-video');
    if ('IntersectionObserver' in window && lazyVideos.length) {
      var videoObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var video = entry.target;
            video.load();
            video.play().catch(function() {});
            videoObserver.unobserve(video);
          }
        });
      }, { rootMargin: '200px' });
      lazyVideos.forEach(function(v) { videoObserver.observe(v); });
    } else {
      // Fallback: just load them
      lazyVideos.forEach(function(v) { v.load(); v.play().catch(function() {}); });
    }
  </script>
</BaseLayout>
