---
import BaseLayout from '../layouts/BaseLayout.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'

// Read SSI partials at build time
const navHtml = readFileSync(resolve('public/partials/nav.html'), 'utf-8')
const footerHtml = readFileSync(resolve('public/partials/footer.html'), 'utf-8')
const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

// SVG card data for static rendering (German)
const audioTools = [
  { title: 'Audio Konverter', description: 'Konvertieren Sie Audio zwischen MP3, WAV, OGG, FLAC, AAC und M4A.', link: 'https://kodinitools.com/audiokonverter/', svg: '/image/audio-konverter.svg', i18nKey: 'tools.audioConverter' },
  { title: '19-Band EQ Pro', description: '19-Band Equalizer mit Dynamic Compressor, Presets und Aufnahme-Funktion.', link: 'https://kodinitools.com/equaliser19/', svg: '/image/eq19-pro.svg', i18nKey: 'tools.audioEqualizer' },
  { title: 'Musikplayer', description: 'Minimalistischer Audioplayer mit Playlist, Shuffle, Repeat und Visualizer-Funktion.', link: 'https://kodinitools.com/ultimativermusikplayer/', svg: '/image/musikplayer.svg', i18nKey: 'tools.musicPlayer' },
  { title: 'Audio Visualizer', description: 'Erstellen Sie beeindruckende MP4-Videos für TikTok, Instagram und YouTube.', link: 'https://kodinitools.com/visualizer/', svg: '/image/audio-visualizer.svg', i18nKey: 'tools.audioVisualizer' },
  { title: 'MP3 Konverter', description: 'Konvertieren Sie Audiodateien schnell und einfach in das MP3-Format.', link: 'https://kodinitools.com/mp3konverter/', svg: '/image/mp3-konverter.svg', i18nKey: 'tools.mp3Converter' },
  { title: 'Interaktiver Audio Equalizer', description: 'Bearbeiten Sie Ihre Audiodateien mit einem intuitiven grafischen Equalizer.', link: 'https://kodinitools.com/audioequalizer/', svg: '/image/interaktiver-equalizer.svg', i18nKey: 'tools.interactiveEqualizer' },
  { title: 'Moderner Musikplayer', description: 'Schlanker und moderner Audio-Player mit allen wichtigen Funktionen.', link: 'https://kodinitools.com/modernermusikplayer/', svg: '/image/moderner-musikplayer.svg', i18nKey: 'tools.modernPlayer' },
  { title: 'Audioplaylist Generator', description: 'Erstellen Sie automatisch Playlists aus Ihren Audiodateien.', link: 'https://kodinitools.com/playlist_generator/', svg: '/image/playlist-generator.svg', i18nKey: 'tools.playlistGenerator' },
  { title: 'Alarmtool', description: 'Zuverlässiges Alarm-Tool für Erinnerungen und Wecker.', link: 'https://kodinitools.com/alarmtool/', svg: '/image/alarmtool.svg', i18nKey: 'tools.alarmTool' },
  { title: 'Audio Normalizer', description: 'Normalisieren Sie die Lautstärke Ihrer Audiodateien automatisch.', link: 'https://kodinitools.com/audionormalisierer/', svg: '/image/audio-normalizer.svg', i18nKey: 'tools.audioNormalizer' },
  { title: 'Playlist zu WebM Konverter', description: 'Bis zu 50 Audio-Tracks in eine WebM-Datei konvertieren.', link: 'https://kodinitools.com/playlistkonverter/', svg: '/image/playlist-konverter.svg', i18nKey: 'tools.playlistToWebm' }
]

const imageTools = [
  { title: 'Bildkonverter', description: 'Konvertieren Sie Bilder zwischen JPG, PNG, WebP, AVIF, GIF und BMP.', link: 'https://kodinitools.com/bildkonverter/', svg: '/image/bildkonverter.svg', i18nKey: 'imageTools.imageConverter' },
  { title: 'Batch Bildbearbeitung', description: 'Bearbeiten Sie 100+ Bilder gleichzeitig: Größe ändern, umbenennen, exportieren.', link: 'https://kodinitools.com/bilderseriebearbeiten/', svg: '/image/bilderseriebearbeiten.svg', i18nKey: 'imageTools.batchImageEditor' },
  { title: 'Fotocollage', description: 'Erstellen Sie kreative Fotocollagen aus Ihren Bildern.', link: 'https://kodinitools.com/collagemaker', svg: '/image/collagemacher.svg', i18nKey: 'imageTools.photoCollage' }
]

const diverseTools = [
  { title: 'Kodini Farbextraktor', description: 'Extrahieren Sie dominante Farben aus Bildern.', link: 'https://kodinitools.com/kodini-color-extractor/', svg: '/image/farbextraktor.svg', i18nKey: 'diverseTools.colorExtractor' },
  { title: 'Videokonverter', description: 'Konvertieren Sie Videos in verschiedene Formate.', link: 'https://kodinitools.com/videokonverter/', svg: '/image/videokonverter.svg', i18nKey: 'diverseTools.videoConverter' }
]

const features = [
  { text: '100% Kostenlos', i18nKey: 'hero.features.free' },
  { text: 'Datenschutz', i18nKey: 'hero.features.privacy' },
  { text: 'Browser-basiert', i18nKey: 'hero.features.browserBased' },
  { text: 'Server-basiert', i18nKey: 'hero.features.serverBased' },
  { text: 'Mehrsprachig', i18nKey: 'hero.features.multiLanguage' },
  { text: 'Keine Installation', i18nKey: 'hero.features.noInstall' }
]
---

<BaseLayout>
  <div id="app">
    <!-- Global Background Effects -->
    <div class="global-background">
      <div class="global-gradient"></div>
      <div class="global-noise"></div>
      <div class="mouse-spotlight" id="mouseSpotlight"></div>
    </div>

    <!-- Global Floating Tool Icons Background -->
    <div class="floating-icons-global" id="floatingIcons">
      <div class="floating-icon icon-1">
        <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 20h5v-10h5v20h5v-15h5v10h5v-5h5v10h5v-15h5v20h5v-10h5v5h5v-8h5"/>
        </svg>
      </div>
      <div class="floating-icon icon-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <div class="floating-icon icon-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="21" x2="4" y2="14"/>
          <line x1="9" y1="21" x2="9" y2="8"/>
          <line x1="14" y1="21" x2="14" y2="12"/>
          <line x1="19" y1="21" x2="19" y2="5"/>
        </svg>
      </div>
      <div class="floating-icon icon-5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </div>
      <div class="floating-icon icon-7">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M15.54 8.46a5 5 0 010 7.07"/>
          <path d="M19.07 4.93a10 10 0 010 14.14"/>
        </svg>
      </div>
      <div class="floating-icon icon-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2v4h12v12h4"/>
          <path d="M18 22v-4H6V6H2"/>
        </svg>
      </div>
      <div class="floating-icon icon-9">
        <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 20h5v-10h5v20h5v-15h5v10h5v-5h5v10h5v-15h5v20h5v-10h5v5h5v-8h5"/>
        </svg>
      </div>
      <div class="floating-icon icon-10">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <div class="floating-icon icon-11">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
      </div>
      <div class="floating-icon icon-12">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="21" x2="4" y2="14"/>
          <line x1="9" y1="21" x2="9" y2="8"/>
          <line x1="14" y1="21" x2="14" y2="12"/>
          <line x1="19" y1="21" x2="19" y2="5"/>
        </svg>
      </div>
    </div>

    <!-- Navigation (SSI Partial) -->
    <Fragment set:html={navHtml} />

    <!-- Hero Section with Animated Mesh Gradient -->
    <section class="hero">
      <div class="mesh-gradient-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
        <div class="mesh-blob mesh-blob-4"></div>
      </div>
      <div class="noise-overlay"></div>

      <div class="hero-content">
        <div class="hero-promo">
          <div class="hero-logo">
            <img src="https://kodinitools.com/images/logo.svg" alt="KodiniTools Logo" />
          </div>
          <h1 class="hero-title typing-title">
            <span class="typed-text" id="typedText"></span>
          </h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">Sichere Bearbeitung - Im Browser oder auf unseren Servern<br/>Keine Installation, keine Anmeldung</p>
        </div>

        <!-- Features Grid -->
        <div class="features-grid">
          {features.map((feature) => (
            <div class="feature-card">
              <div class="feature-text" data-i18n={feature.i18nKey}>{feature.text}</div>
            </div>
          ))}
        </div>

        <!-- Spotlight Search Box -->
        <div class="search-container">
          <div class="search-box spotlight-search">
            <svg class="search-icon-svg" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input
              type="text"
              id="searchInput"
              placeholder="Tools durchsuchen..."
              data-i18n-placeholder="search.placeholder"
              class="search-input"
            />
            <kbd class="search-kbd" id="searchKbd">&#x2318;K</kbd>
            <button
              id="searchClear"
              class="search-clear"
              aria-label="Suche löschen"
              data-i18n-aria="search.clear"
              style="display: none;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Search Results Section (hidden by default, shown via JS) -->
    <section id="searchResults" class="tools-section search-results-section" style="display: none;">
      <div class="section-header">
        <h2 data-i18n="search.resultsTitle">Suchergebnisse</h2>
        <p id="searchResultsCount"></p>
      </div>
      <div id="searchResultsGrid" class="svg-card-grid"></div>
    </section>

    <!-- Audio Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="tools.sectionTitle">Audio Tools</h2>
      </div>

      <div class="svg-card-grid">
        {audioTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="svg-card">
              <img src={tool.svg} alt={tool.title} loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="imageTools.sectionTitle">Bild Tools</h2>
      </div>

      <div class="svg-card-grid">
        {imageTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="svg-card">
              <img src={tool.svg} alt={tool.title} loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Diverse Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="diverseTools.sectionTitle">Diverse Tools</h2>
      </div>

      <div class="svg-card-grid">
        {diverseTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-de={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="svg-card">
              <img src={tool.svg} alt={tool.title} loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Scroll to Top Button -->
    <button
      id="scrollToTop"
      class="scroll-to-top"
      aria-label="Nach oben scrollen"
      data-i18n-aria="search.scrollTop"
      style="display: none;"
    >
      &uarr;
    </button>

    <!-- Footer (SSI Partial) -->
    <Fragment set:html={footerHtml} />

    <!-- Cookie Banner (SSI Partial) -->
    <Fragment set:html={cookieBannerHtml} />
  </div>

  <!-- Minimal Vanilla JS for interactivity -->
