---
import GlobalNav from '../components/GlobalNav.astro'
import TickerBar from '../components/TickerBar.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteFont from '../components/SiteFont.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'
import { getContent } from '../content/content'
const de = getContent('de')

const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

const questions = Object.values(de.faq.questions)

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
}
---

<!DOCTYPE html>
<html lang="de">
<head>
  <!-- Google Consent Mode v2 -->
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);} // eslint-disable-line prefer-rest-params -- offizielles Google-Snippet, arguments bewusst
  gtag('consent', 'default', {
    'ad_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied',
    'analytics_storage': 'denied', 'functionality_storage': 'denied',
    'personalization_storage': 'denied', 'security_storage': 'granted', 'wait_for_update': 500
  });
  (function() {
    try {
      const c = JSON.parse(localStorage.getItem('cookieConsent') || '{}');
      if (c.analytics) gtag('consent', 'update', { 'analytics_storage': 'granted', 'functionality_storage': 'granted', 'personalization_storage': 'granted' });
      if (c.marketing) gtag('consent', 'update', { 'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted' });
    } catch { /* Consent optional – Fehler bewusst ignorieren */ }
  })();
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T7NS656K');</script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FAQ – Häufige Fragen zu KodiniTools | Kostenlose Online Tools</title>
  <meta name="description" content="Antworten auf die häufigsten Fragen zu KodiniTools: MP3 konvertieren, Bilder umwandeln, Audio normalisieren, Datenschutz, Dateiformate und mehr – kostenlos, ohne Registrierung." />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="de" />
  <link rel="canonical" href="https://kodinitools.com/faq/" />
  <link rel="alternate" hreflang="de" href="https://kodinitools.com/faq/" />
  <link rel="alternate" hreflang="en" href="https://kodinitools.com/en/faq/" />
  <link rel="alternate" hreflang="x-default" href="https://kodinitools.com/faq/" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kodinitools.com/faq/" />
  <meta property="og:title" content="FAQ – Häufige Fragen zu KodiniTools" />
  <meta property="og:description" content="Antworten zu MP3 konvertieren, Bildformate, Datenschutz, Dateigrössen und mehr." />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="KodiniTools" />

  <meta name="theme-color" content="#014f99" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <style>
    @import '../styles/global.css';
  </style>
  <SiteFont />
</head>
<body>
  <div class="global-background" aria-hidden="true">
    <div class="global-gradient"></div>
    <div class="global-noise"></div>
  </div>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T7NS656K" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <GlobalNav lang="de" />
  <TickerBar lang="de" />

  <main class="faq-main">
    <div class="faq-container">

      <!-- Breadcrumb -->
      <nav class="faq-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Startseite</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">FAQ</span>
      </nav>

      <!-- Header -->
      <header class="faq-header">
        <h1>{de.faq.title}</h1>
        <p class="faq-subtitle">{de.faq.subtitle}</p>
      </header>

      <!-- FAQ Accordion -->
      <section class="faq-list" aria-label="Häufig gestellte Fragen">
        {questions.map((item, index) => (
          <div class="faq-item" id={`faq-${index + 1}`}>
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls={`faq-answer-${index + 1}`}
            >
              <span class="faq-question-text">{item.question}</span>
              <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>
            <div
              class="faq-answer"
              id={`faq-answer-${index + 1}`}
              hidden
            >
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </section>

      <!-- Back to home -->
      <div class="faq-back">
        <a href="/" class="faq-back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
          </svg>
          {de.faq.backToHome}
        </a>
      </div>

    </div>
  </main>

  <SiteFooter lang="de" />
  <Fragment set:html={cookieBannerHtml} />

  <style>
    .faq-main {
      min-height: calc(100vh - 140px);
      padding: 2rem 1rem 4rem;
    }

    .faq-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .faq-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-muted, #4f6f8e);
      margin-bottom: 2rem;
    }

    .faq-breadcrumb a {
      color: var(--primary-color, #014f99);
      text-decoration: none;
    }

    .faq-breadcrumb a:hover { text-decoration: underline; }

    .faq-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .faq-header h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }

    [data-theme="dark"] .faq-header h1 {
      background: linear-gradient(135deg, #c9984d 0%, #f8e1a9 100%);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .faq-subtitle {
      font-size: 1rem;
      color: var(--text-secondary, #014f99);
      max-width: 500px;
      margin: 0 auto;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .faq-item {
      background: var(--bg-secondary, #ffffff);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1rem;
      overflow: hidden;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .faq-item:hover {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 4px 16px rgba(1, 79, 153, 0.08);
    }

    [data-theme="dark"] .faq-item:hover {
      border-color: var(--accent-color, #c9984d);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }

    .faq-item.is-open {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 4px 20px rgba(1, 79, 153, 0.1);
    }

    [data-theme="dark"] .faq-item.is-open {
      border-color: var(--accent-color, #c9984d);
    }

    .faq-question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      padding: 1.1rem 1.25rem;
      background: transparent;
      border: none;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-color, #003971);
      transition: color 0.2s ease;
    }

    .faq-question:hover { color: var(--primary-color, #014f99); }

    [data-theme="dark"] .faq-question { color: var(--text-color, #f9f2d5); }
    [data-theme="dark"] .faq-question:hover { color: var(--primary-color, #c9984d); }

    .faq-question-text { flex: 1; line-height: 1.4; }

    .faq-icon {
      flex-shrink: 0;
      color: var(--primary-color, #014f99);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] .faq-icon { color: var(--primary-color, #c9984d); }

    .faq-item.is-open .faq-icon { transform: rotate(180deg); }

    .faq-answer {
      padding: 0 1.25rem 1.25rem;
      border-top: 1px solid var(--border-color, #d4c09a);
    }

    .faq-answer[hidden] { display: none; }

    .faq-answer p {
      font-size: 0.9rem;
      line-height: 1.7;
      color: var(--text-secondary, #014f99);
      padding-top: 1rem;
    }

    [data-theme="dark"] .faq-answer p { color: var(--text-secondary, #f8e1a9); }

    .faq-back {
      margin-top: 3rem;
      text-align: center;
    }

    .faq-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      color: #ffffff;
      text-decoration: none;
      border-radius: 0.75rem;
      font-weight: 600;
      font-size: 0.9rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 15px rgba(1, 79, 153, 0.3);
    }

    [data-theme="dark"] .faq-back-btn {
      background: linear-gradient(135deg, #c9984d 0%, #a67d3d 100%);
      color: #091428;
      box-shadow: 0 4px 15px rgba(201, 152, 77, 0.3);
    }

    .faq-back-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 79, 153, 0.4);
    }

    [data-theme="dark"] .faq-back-btn:hover {
      box-shadow: 0 6px 20px rgba(201, 152, 77, 0.4);
    }

    @media (max-width: 600px) {
      .faq-main { padding: 1.5rem 0.75rem 3rem; }
      .faq-question { padding: 0.9rem 1rem; font-size: 0.88rem; }
      .faq-answer { padding: 0 1rem 1rem; }
      .faq-answer p { font-size: 0.85rem; }
    }
  </style>

  <script is:inline>
  (function() {
    // Apply saved theme immediately
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);

    document.addEventListener('DOMContentLoaded', function() {
      const items = document.querySelectorAll('.faq-item');
      items.forEach(function(item) {
        const btn = item.querySelector('.faq-question');
        const answer = item.querySelector('.faq-answer');
        if (!btn || !answer) return;

        btn.addEventListener('click', function() {
          const isOpen = item.classList.contains('is-open');
          // Close all others
          items.forEach(function(other) {
            if (other !== item) {
              other.classList.remove('is-open');
              const otherBtn = other.querySelector('.faq-question');
              const otherAnswer = other.querySelector('.faq-answer');
              if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
              if (otherAnswer) otherAnswer.hidden = true;
            }
          });
          // Toggle this one
          item.classList.toggle('is-open', !isOpen);
          btn.setAttribute('aria-expanded', String(!isOpen));
          answer.hidden = isOpen;
        });
      });

      // Open first item by default
      if (items.length > 0) {
        const first = items[0];
        first.classList.add('is-open');
        const firstBtn = first.querySelector('.faq-question');
        const firstAnswer = first.querySelector('.faq-answer');
        if (firstBtn) firstBtn.setAttribute('aria-expanded', 'true');
        if (firstAnswer) firstAnswer.hidden = false;
      }
    });
  })();
  </script>
</body>
</html>
