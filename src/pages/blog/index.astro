---
import GlobalNav from '../../components/GlobalNav.astro'
import TickerBar from '../../components/TickerBar.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteFont from '../../components/SiteFont.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'

const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

const posts = [
  {
    slug: '/blog/schluss-mit-abo-wahnsinn',
    title: 'Schluss mit dem Abo-Wahnsinn: Warum KodiniTools auf Freiheit statt Paywalls setzt',
    description: 'Die Philosophie hinter KodiniTools: kostenlose, uneingeschränkte Tools statt Abo-Zwang – finanziert durch freiwillige Spenden statt starrer Paywalls.',
    date: '25. Juni 2026',
    tag: 'Philosophie',
    minutes: 4,
    featured: true,
    image: '/image/kodinitools-blog.webp',
  },
  {
    slug: '/blog/ultimativer-musikplayer',
    title: 'Ultimativer Musikplayer: Lokale Musik im Browser abspielen mit Visualizer',
    description: 'Dateien oder ganze Ordner per Drag & Drop laden, Playlist mit Shuffle und Repeat, LED-Equalizer-Visualizer, alle gängigen Audioformate – ohne Upload.',
    date: '18. September 2026',
    tag: 'Audio',
    minutes: 4,
    image: '/image/ultimativermusikplayer-blog-de.png',
    newTab: true,
  },
  {
    slug: '/blog/alarmtool-eigener-alarmton',
    title: 'Alarmtool: Eigenen Alarmton mit Oszillatoren erstellen und aufnehmen',
    description: 'Alarm- und Signaltöne aus bis zu 12 Oszillatoren gestalten, Wellenform, Frequenz, Hüllkurve und Filter einstellen, als Preset speichern und aufnehmen – im Browser.',
    date: '17. September 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/alarmtool-blog-de.png',
  },
  {
    slug: '/blog/farbextraktor-farbpalette',
    title: 'Farben aus Bild extrahieren & Farbpalette generieren: Kostenlos im Browser',
    description: 'Dominante Farben eines Bildes als HEX oder RGB auslesen, Bild live anpassen und harmonische Paletten per Leertaste erzeugen – ohne Upload.',
    date: '16. September 2026',
    tag: 'Bild',
    minutes: 6,
    image: '/image/farbextraktor-blog-de.png',
  },
  {
    slug: '/blog/equalizer-19-band',
    title: 'Equalizer online: 19-Band EQ mit Kompressor kostenlos im Browser nutzen',
    description: '19 Frequenzbänder von 20 Hz bis 20 kHz, Presets für Rock, Pop und Podcast, dynamischer Kompressor, Pegelmeter und Export als WAV oder WebM – ohne Upload.',
    date: '16. September 2026',
    tag: 'Audio',
    minutes: 6,
    image: '/image/audio-equalizer19-blog-de.png',
  },
  {
    slug: '/blog/texteditor-online',
    title: 'Texteditor online: Texte schreiben, formatieren & exportieren ohne Installation',
    description: 'Schreiben, formatieren, Bilder einfügen, Markdown-Vorschau, Wortzähler, Drucken und Speichern – kostenlos im Browser, ohne Upload.',
    date: '16. September 2026',
    tag: 'Text',
    minutes: 5,
    image: '/image/texteditor-de.png',
  },
  {
    slug: '/blog/wiedergabeliste-erstellen',
    title: 'Wiedergabeliste erstellen: M3U, PLS & XSPF kostenlos im Browser generieren',
    description: 'Audiodateien hinzufügen, Reihenfolge festlegen, als M3U, M3U8, PLS, XSPF, CUE, CSV oder JSON speichern – ohne Upload, direkt im Browser.',
    date: '15. September 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/wiedergabeliste-generator.png',
  },
  {
    slug: '/blog/audiodatei-format-aendern',
    title: 'Audiodatei Format ändern: DSGVO-konform & kostenlos online',
    description: 'MP3, WAV, OGG, FLAC, AAC – welches Format wofür? Und was bedeutet DSGVO bei Audio-Konvertern?',
    date: '20. Juni 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/audiokonverter-blog-de.png',
  },
  {
    slug: '/blog/jpg-zu-webp-konvertieren',
    title: 'JPG zu WebP konvertieren: Bilder bis 30% kleiner ohne Qualitätsverlust',
    description: 'Wie WebP Ihre Google-Rankings verbessert und wie die Konvertierung in 5 Schritten gelingt.',
    date: '5. Juni 2026',
    tag: 'Bild',
    minutes: 4,
    image: '/image/bildkonverter-blog-de.png',
  },
  {
    slug: '/blog/audio-normalisieren',
    title: 'Audio Lautstärke normalisieren: LUFS & dBFS verständlich erklärt',
    description: 'Spotify -14 LUFS, Podcasts -16 LUFS, Rundfunk -23 LUFS – welcher Standard gilt wann?',
    date: '8. Juni 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/normalieser-blog-de.png',
  },
  {
    slug: '/blog/musik-video-tiktok',
    title: 'Musik-Video für TikTok erstellen: Kostenlos & ohne App',
    description: 'Audio Visualizer im Browser nutzen – MP4-Export im Hochformat 9:16 für TikTok und Reels.',
    date: '11. Juni 2026',
    tag: 'Video',
    minutes: 4,
    image: '/image/visualizer-blog-de.png',
  },
  {
    slug: '/blog/bilder-batch-verkleinern',
    title: 'Mehrere Bilder gleichzeitig verkleinern: Batch-Bearbeitung leicht gemacht',
    description: '100+ Bilder in Sekunden skalieren, umbenennen und als ZIP exportieren – ohne Installation.',
    date: '14. Juni 2026',
    tag: 'Bild',
    minutes: 4,
    image: '/image/bilderserie-blog-de.png',
  },
  {
    slug: '/blog/fotocollage-erstellen',
    title: 'Fotocollage kostenlos erstellen ohne App – direkt im Browser',
    description: 'Layouts für Instagram, Pinterest und Drucken. Bilder verlassen nie Ihren Browser – DSGVO-konform.',
    date: '17. Juni 2026',
    tag: 'Bild',
    minutes: 4,
    image: '/image/collagemaker-blog-de.png',
  },
]

const featuredPost = posts.find((post) => post.featured)
const regularPosts = posts.filter((post) => !post.featured)
---

<!DOCTYPE html>
<html lang="de">
<head>
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);} // eslint-disable-line prefer-rest-params -- offizielles Google-Snippet, arguments bewusst
  gtag('consent', 'default', {
    'ad_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied',
    'analytics_storage': 'denied', 'functionality_storage': 'denied',
    'personalization_storage': 'denied', 'security_storage': 'granted', 'wait_for_update': 500
  });
  (function() {
    try {
      const c = JSON.parse(localStorage.getItem('cookieConsent') || '{}');
      if (c.analytics) gtag('consent', 'update', { 'analytics_storage': 'granted', 'functionality_storage': 'granted', 'personalization_storage': 'granted' });
      if (c.marketing) gtag('consent', 'update', { 'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted' });
    } catch { /* Consent optional – Fehler bewusst ignorieren */ }
  })();
  </script>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T7NS656K');</script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog – Tipps & Anleitungen für Audio und Bildbearbeitung | KodiniTools</title>
  <meta name="description" content="How-to Guides für kostenlose Online-Tools: Audiodatei Format ändern, JPG zu WebP konvertieren, Audio normalisieren, TikTok Videos erstellen und mehr – DSGVO-konform." />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="de" />
  <link rel="canonical" href="https://kodinitools.com/blog/" />
  <link rel="alternate" hreflang="de" href="https://kodinitools.com/blog/" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kodinitools.com/blog/" />
  <meta property="og:title" content="Blog – Tipps & Anleitungen für Audio und Bildbearbeitung | KodiniTools" />
  <meta property="og:description" content="How-to Guides für kostenlose Online-Tools: Audio konvertieren, Bilder optimieren, TikTok Videos erstellen und mehr." />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="KodiniTools" />

  <meta name="theme-color" content="#014f99" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <style>
    @import '../../styles/global.css';

    .blog-index-main {
      min-height: calc(100vh - 140px);
      padding: 2rem 1rem 5rem;
    }

    .blog-index-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .blog-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--text-muted, #4f6f8e);
      margin-bottom: 2rem;
    }

    .blog-breadcrumb a {
      color: var(--primary-color, #014f99);
      text-decoration: none;
    }

    .blog-breadcrumb a:hover { text-decoration: underline; }

    .blog-index-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .blog-index-header h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.75rem;
      line-height: 1.2;
    }

    [data-theme="dark"] .blog-index-header h1 {
      background: linear-gradient(135deg, #c9984d 0%, #f8e1a9 100%);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .blog-index-subtitle {
      font-size: 1rem;
      color: var(--text-secondary, #014f99);
      max-width: 520px;
      margin: 0 auto;
    }

    /* Content panel: keeps text readable on the animated global background (watermark, grid) */
    .blog-panel {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1.1rem;
      padding: clamp(1.25rem, 4vw, 2.25rem);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }

    [data-theme="dark"] .blog-panel {
      background: rgba(14, 28, 50, 0.92);
    }

    .blog-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .blog-featured-card {
      display: grid;
      grid-template-columns: minmax(200px, 320px) 1fr;
      gap: 0;
      background: var(--bg-secondary, #ffffff);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1.1rem;
      overflow: hidden;
      text-decoration: none;
      margin-bottom: 1.5rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .blog-featured-card:hover {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 8px 28px rgba(1, 79, 153, 0.14);
      text-decoration: none;
    }

    [data-theme="dark"] .blog-featured-card:hover {
      border-color: var(--primary-color, #e8a945);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
    }

    .blog-featured-media {
      min-height: 180px;
    }

    .blog-featured-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .blog-featured-content {
      padding: 1.5rem 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .blog-featured-content h2 {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--text-color, #003971);
      margin: 0 0 0.5rem;
      line-height: 1.3;
    }

    [data-theme="dark"] .blog-featured-content h2 { color: var(--text-color, #f9f2d5); }

    /* Description inside image cards: explicit color, otherwise the browser link color of the <a> wrapper leaks through */
    .blog-featured-content p {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--text-secondary, #4f6f8e);
      margin: 0;
    }

    [data-theme="dark"] .blog-featured-content p { color: var(--text-secondary, #f8e1a9); }

    .blog-card-tag-featured {
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      color: #ffffff;
    }

    [data-theme="dark"] .blog-card-tag-featured {
      background: linear-gradient(135deg, #c9984d 0%, #a67d3d 100%);
      color: #091428;
    }

    @media (max-width: 640px) {
      .blog-featured-card { grid-template-columns: 1fr; }
      .blog-featured-media { min-height: 160px; }
    }


    /* Regular post with image preview (same layout as featured card, sits inside the grid) */
    .blog-featured-card.blog-card-image {
      margin-bottom: 0;
      border-radius: 1rem;
    }

    .blog-card {
      display: block;
      background: var(--bg-secondary, #ffffff);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1rem;
      padding: 1.25rem 1.5rem;
      text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .blog-card:hover {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 4px 20px rgba(1, 79, 153, 0.1);
      text-decoration: none;
    }

    [data-theme="dark"] .blog-card:hover {
      border-color: var(--primary-color, #e8a945);
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .blog-card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }

    .blog-card-tag {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      color: var(--primary-color, #014f99);
      background: rgba(1,79,153,0.08);
    }

    [data-theme="dark"] .blog-card-tag {
      background: rgba(201,152,77,0.12);
      color: var(--primary-color, #e8a945);
    }

    .blog-card-meta {
      font-size: 0.78rem;
      color: var(--text-muted, #4f6f8e);
    }

    .blog-card h2 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-color, #003971);
      margin: 0 0 0.4rem;
      line-height: 1.35;
    }

    [data-theme="dark"] .blog-card h2 { color: var(--text-color, #f9f2d5); }

    .blog-card p {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--text-secondary, #4f6f8e);
      margin: 0;
    }

    .blog-card-arrow {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-top: 0.75rem;
      color: var(--primary-color, #014f99);
      font-size: 0.8rem;
      font-weight: 600;
      gap: 0.3rem;
    }

    [data-theme="dark"] .blog-card-arrow { color: var(--primary-color, #e8a945); }

    @media (max-width: 600px) {
      .blog-index-main { padding: 1.5rem 0.75rem 3rem; }
      .blog-panel { padding: 1rem 0.9rem; border-radius: 0.9rem; }
      .blog-card { padding: 1rem 1.1rem; }
    }
  </style>
  <SiteFont />
</head>
<body>
  <div class="global-background" aria-hidden="true">
    <div class="global-gradient"></div>
    <div class="global-noise"></div>
  </div>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T7NS656K" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <GlobalNav lang="de" />
  <TickerBar lang="de" />

  <main class="blog-index-main">
    <div class="blog-index-container">

      <nav class="blog-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Startseite</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Blog</span>
      </nav>

      <div class="blog-panel">

      <header class="blog-index-header">
        <h1>Blog – Tipps &amp; Anleitungen</h1>
        <p class="blog-index-subtitle">How-to Guides für Audio- und Bildbearbeitung – kostenlos, DSGVO-konform, ohne Registrierung.</p>
      </header>

      {featuredPost && (
        <a href={featuredPost.slug} class="blog-featured-card">
          <div class="blog-featured-media">
            <img src={featuredPost.image} alt="" width="640" height="360" loading="lazy" />
          </div>
          <div class="blog-featured-content">
            <div class="blog-card-header">
              <span class="blog-card-tag blog-card-tag-featured">{featuredPost.tag}</span>
              <span class="blog-card-meta">{featuredPost.date} · {featuredPost.minutes} Min.</span>
            </div>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.description}</p>
            <div class="blog-card-arrow">
              Artikel lesen
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      )}

      <div class="blog-grid">
        {regularPosts.map((post) =>
          post.image ? (
            <a href={post.slug} class="blog-featured-card blog-card-image" target={post.newTab ? '_blank' : undefined} rel={post.newTab ? 'noopener' : undefined}>
              <div class="blog-featured-media">
                <img src={post.image} alt="" width="640" height="360" loading="lazy" />
              </div>
              <div class="blog-featured-content">
                <div class="blog-card-header">
                  <span class="blog-card-tag">{post.tag}</span>
                  <span class="blog-card-meta">{post.date} · {post.minutes} Min.</span>
                </div>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <div class="blog-card-arrow">
                  Artikel lesen
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          ) : (
            <a href={post.slug} class="blog-card">
              <div class="blog-card-header">
                <span class="blog-card-tag">{post.tag}</span>
                <span class="blog-card-meta">{post.date} · {post.minutes} Min.</span>
              </div>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <div class="blog-card-arrow">
                Artikel lesen
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </a>
          )
        )}
      </div>

      </div>

    </div>
  </main>

  <SiteFooter lang="de" />
  <Fragment set:html={cookieBannerHtml} />

  <script is:inline>
  (function() {
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
  </script>
</body>
</html>
