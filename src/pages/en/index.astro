    // Reusable translation function
    var pageT;
    function applyPageTranslations() {
      var pageLang = localStorage.getItem('locale') || 'en';
      pageT = PAGE_I18N[pageLang] || PAGE_I18N['en'];

      // Apply text translations
      document.querySelectorAll('#app [data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (pageT[key]) {
          if (key === 'hero.subtitle') {
            el.innerHTML = pageT[key].replace(/\n/g, '<br/>');
          } else {
            el.textContent = pageT[key];
          }
        }
      });

      // Apply placeholder translations
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (pageT[key]) el.placeholder = pageT[key];
      });

      // Apply aria-label translations
      document.querySelectorAll('#app [data-i18n-aria]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-aria');
        if (pageT[key]) el.setAttribute('aria-label', pageT[key]);
      });

      // Update SVG images on tool cards based on language
      document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
        var key = card.getAttribute('data-i18n-key');
        var svgPath = pageT[key + '.svg'];
        if (svgPath) {
          var img = card.querySelector('img');
          if (img && img.getAttribute('src') !== svgPath) {
            img.setAttribute('src', svgPath);
          }
          var titleText = pageT[key + '.title'];
          if (titleText && img) {
            img.setAttribute('alt', titleText);
          }
        }
        // Update data-title and data-description for search
        var titleKey = key + '.title';
        var descKey = key + '.description';
        if (pageT[titleKey]) {
          card.setAttribute('data-title', pageT[titleKey]);
          var titleEl = card.querySelector('.tool-card-title');
          if (titleEl) titleEl.textContent = pageT[titleKey];
        }
        if (pageT[descKey]) {
          card.setAttribute('data-description', pageT[descKey]);
          var descEl = card.querySelector('.tool-card-desc');
          if (descEl) descEl.textContent = pageT[descKey];
          var popupDescEl = card.querySelector('.tool-popup-desc');
          if (popupDescEl) popupDescEl.textContent = pageT[descKey];
        }
      });

      // Update typing text on language switch (immediate, no animation)
      var typedEl = document.getElementById('typedText');
      if (typedEl && typedEl.textContent.length > 0) {
        typedEl.textContent = pageT['hero.title'] || '';
      }
    }

    // Apply initially
    applyPageTranslations();

    // Live update on language change (without reload)
    window.addEventListener('locale-changed', applyPageTranslations);

    // --- Typing Animation ---
    var typedTextEl = document.getElementById('typedText');
    if (typedTextEl) {
      var fullTitle = pageT['hero.title'] || 'Free Online Tools for Audio & Images';
      var currentIndex = 0;
      function typeNextChar() {
        if (currentIndex < fullTitle.length) {
          typedTextEl.textContent += fullTitle[currentIndex];
          currentIndex++;
          setTimeout(typeNextChar, Math.random() * 50 + 50);
        }
      }
      setTimeout(typeNextChar, 500);
    }

    // --- Mouse Spotlight ---
    const spotlight = document.getElementById('mouseSpotlight');
    const floatingIcons = document.getElementById('floatingIcons');
    if (spotlight) {
      document.addEventListener('mousemove', function(e) {
        const xPct = (e.clientX / window.innerWidth) * 100;
        const yPct = (e.clientY / window.innerHeight) * 100;
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const color = isDark ? 'rgba(201, 152, 77, 0.15)' : 'rgba(1, 79, 153, 0.20)';
        spotlight.style.background = 'radial-gradient(1200px circle at ' + xPct + '% ' + yPct + '%, ' + color + ', transparent 45%)';

        // Parallax floating icons
        if (floatingIcons) {
          var icons = floatingIcons.querySelectorAll('.floating-icon');
          icons.forEach(function(icon, index) {
            var speed = 0.08 + (index * 0.015);
            var x = (e.clientX - window.innerWidth / 2) * speed;
            var y = (e.clientY - window.innerHeight / 2) * speed;
            var scrollY = window.scrollY * (0.08 + index * 0.025);
            icon.style.transform = 'translate(' + x + 'px, ' + (y + scrollY) + 'px)';
          });
        }
      });
    }

    // --- Search Functionality ---
    var searchInput = document.getElementById('searchInput');
    var searchKbd = document.getElementById('searchKbd');
    var searchClear = document.getElementById('searchClear');
    var searchResults = document.getElementById('searchResults');
    var searchResultsCount = document.getElementById('searchResultsCount');
    var searchResultsGrid = document.getElementById('searchResultsGrid');

    var allToolCards = document.querySelectorAll('.svg-card-link[data-title]');

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        var query = searchInput.value.toLowerCase().trim();

        if (searchKbd) searchKbd.style.display = query ? 'none' : 'flex';
        if (searchClear) searchClear.style.display = query ? 'flex' : 'none';

        if (!query) {
          if (searchResults) searchResults.style.display = 'none';
          return;
        }

        var matches = [];
        allToolCards.forEach(function(card) {
          var title = (card.getAttribute('data-title') || '').toLowerCase();
          var desc = (card.getAttribute('data-description') || '').toLowerCase();
          if (title.includes(query) || desc.includes(query)) {
            matches.push(card);
          }
        });

        if (searchResults && searchResultsCount && searchResultsGrid) {
          searchResults.style.display = 'block';
          if (matches.length === 0) {
            searchResultsCount.textContent = pageT['search.noResults'] || 'No tools found. Try a different search term.';
            searchResultsCount.className = 'no-results';
            searchResultsGrid.innerHTML = '';
          } else {
            searchResultsCount.textContent = matches.length + ' ' + (pageT['search.resultsFound'] || 'tools found');
            searchResultsCount.className = '';
            searchResultsGrid.innerHTML = '';
            matches.forEach(function(card) {
              var clone = card.cloneNode(true);
              clone.className = 'svg-card-link';
              searchResultsGrid.appendChild(clone);
            });
          }
        }
      });

      if (searchClear) {
        searchClear.addEventListener('click', function() {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
        });
      }
    }

    // --- Scroll to Top ---
    var scrollBtn = document.getElementById('scrollToTop');
    if (scrollBtn) {
      window.addEventListener('scroll', function() {
        scrollBtn.style.display = window.scrollY > 400 ? 'flex' : 'none';

        // Scroll parallax for floating icons
        if (floatingIcons) {
          var icons = floatingIcons.querySelectorAll('.floating-icon');
          icons.forEach(function(icon, index) {
            var speed = 0.08 + (index * 0.025);
            var yOffset = window.scrollY * speed;
            var current = icon.style.transform || '';
            // Only update if no mouse transform is applied
            if (!current.includes('translate')) {
              icon.style.transform = 'translateY(' + yOffset + 'px)';
            }
          });
        }
      }, { passive: true });

      scrollBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // --- 3D Tilt Effect for SVG Cards ---
    var isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    if (!isTouchDevice) {
      document.addEventListener('mousemove', function(e) {
        var target = e.target;
        if (!target || typeof target.closest !== 'function') return;
        var card = target.closest('.tool-card');
        if (!card) return;

        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / 18;
        var rotateY = (centerX - x) / 18;

        card.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateY(-5px)';
      });

      document.addEventListener('mouseout', function(e) {
        var target = e.target;
        var relatedTarget = e.relatedTarget;
        if (target && target.classList && target.classList.contains('tool-card') &&
            (!relatedTarget || !target.contains(relatedTarget))) {
          target.style.transform = '';
        }
      });
    }

    // --- Intersection Observer for Scroll Animations ---
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var parent = entry.target.parentElement;
          if (parent) {
            var siblings = Array.from(parent.children);
            var index = siblings.indexOf(entry.target);
            entry.target.style.transitionDelay = (index * 0.08) + 's';
          }
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.tools-section, .svg-card-link').forEach(function(el) {
      el.classList.add('scroll-reveal');
      observer.observe(el);
    });

    // --- Feature Card 3D Tilt ---
    if (!isTouchDevice) {
      var featuresGrid = document.querySelector('.features-grid');
      if (featuresGrid) {
        featuresGrid.addEventListener('mousemove', function(e) {
          var card = e.target.closest('.feature-card');
          if (!card) return;
          var rect = card.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          var rotateX = (y - rect.height / 2) / 12;
          var rotateY = (rect.width / 2 - x) / 12;
          card.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateY(-5px) scale(1.02)';
          card.style.setProperty('--feature-mouse-x', (x / rect.width * 100) + '%');
          card.style.setProperty('--feature-mouse-y', (y / rect.height * 100) + '%');
        });

        featuresGrid.addEventListener('mouseleave', function() {
          featuresGrid.querySelectorAll('.feature-card').forEach(function(card) {
            card.style.transform = '';
            card.style.setProperty('--feature-mouse-x', '50%');
            card.style.setProperty('--feature-mouse-y', '50%');
          });
        });

        featuresGrid.querySelectorAll('.feature-card').forEach(function(card) {
          card.addEventListener('mouseleave', function() {
            card.style.transform = '';
            card.style.setProperty('--feature-mouse-x', '50%');
            card.style.setProperty('--feature-mouse-y', '50%');
          });
        });
      }
    }

    // --- Favorites ---
    var FAV_KEY = 'kdt-favorites';

    function getFavorites() {
      try { return JSON.parse(localStorage.getItem(FAV_KEY)) || []; }
      catch(e) { return []; }
    }

    function saveFavorites(favs) {
      localStorage.setItem(FAV_KEY, JSON.stringify(favs));
    }

    function renderFavorites() {
      var favs = getFavorites();
      var section = document.getElementById('favoritesSection');
      var grid = document.getElementById('favoritesGrid');
      if (!section || !grid) return;
      grid.innerHTML = '';
      if (favs.length === 0) {
        section.style.display = 'none';
        return;
      }
      section.style.display = 'block';
      favs.forEach(function(key) {
        var original = document.querySelector('.tools-section:not(.favorites-section) .svg-card-link[data-i18n-key="' + key + '"]');
        if (!original) return;
        var clone = original.cloneNode(true);
        var btn = clone.querySelector('.fav-btn');
        if (btn) btn.classList.add('is-active');
        attachFavBtn(clone);
        grid.appendChild(clone);
      });
    }

    function updateAllFavButtons() {
      var favs = getFavorites();
      document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
        var key = card.getAttribute('data-i18n-key');
        var btn = card.querySelector('.fav-btn');
        if (!btn) return;
        var inFavSection = !!card.closest('#favoritesSection');
        btn.classList.toggle('is-active', inFavSection || favs.indexOf(key) !== -1);
      });
    }

    function toggleFavorite(key, btnEl) {
      var favs = getFavorites();
      var idx = favs.indexOf(key);
      if (idx === -1) {
        favs.push(key);
      } else {
        favs.splice(idx, 1);
      }
      saveFavorites(favs);
      if (btnEl) {
        btnEl.classList.add('pop');
        btnEl.addEventListener('animationend', function() { btnEl.classList.remove('pop'); }, { once: true });
      }
      renderFavorites();
      updateAllFavButtons();
    }

    function attachFavBtn(cardEl) {
      var btn = cardEl.querySelector('.fav-btn');
      if (!btn) return;
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var key = cardEl.getAttribute('data-i18n-key');
        toggleFavorite(key, btn);
      });
    }

    document.querySelectorAll('.svg-card-link[data-i18n-key]').forEach(function(card) {
      attachFavBtn(card);
    });

    var favClearBtn = document.getElementById('favClearAll');
    if (favClearBtn) {
      favClearBtn.addEventListener('click', function() {
        saveFavorites([]);
        renderFavorites();
        updateAllFavButtons();
      });
    }

    renderFavorites();
    updateAllFavButtons();

    window.addEventListener('locale-changed', function() {
      renderFavorites();
      updateAllFavButtons();
    });
  });
  </script>

  <script>
    // Lazy-load videos below the fold via IntersectionObserver
    var lazyVideos = document.querySelectorAll('video.lazy-video');
    if ('IntersectionObserver' in window && lazyVideos.length) {
      var videoObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var video = entry.target;
            video.load();
            video.play().catch(function() {});
            videoObserver.unobserve(video);
          }
        });
      }, { rootMargin: '200px' });
      lazyVideos.forEach(function(v) { videoObserver.observe(v); });
    } else {
      // Fallback: just load them
      lazyVideos.forEach(function(v) { v.load(); v.play().catch(function() {}); });
    }
  </script>
</EnLayout>
