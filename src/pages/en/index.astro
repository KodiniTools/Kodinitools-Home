---
import EnLayout from '../../layouts/EnLayout.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'

// Read SSI partials at build time
const navHtml = readFileSync(resolve('public/partials/nav.html'), 'utf-8')
const footerHtml = readFileSync(resolve('public/partials/footer.html'), 'utf-8')
const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

// SVG card data for static rendering (English)
const audioTools = [
  { title: 'Audio Converter', description: 'Convert audio between MP3, WAV, OGG, FLAC, AAC and M4A. Supports batch processing and individual quality settings for optimal results.', link: 'https://kodinitools.com/audiokonverter/', svg: '/image/audio-converter.svg', i18nKey: 'tools.audioConverter', badge: 'Batch' },
  { title: '19-Band EQ Pro', description: '19-band equalizer with dynamic compressor, presets and recording function. Perfect for musicians and podcasters who need professional sound right in the browser.', link: 'https://kodinitools.com/equaliser19/', svg: '/image/eq19-pro1.svg', i18nKey: 'tools.audioEqualizer', badge: 'PRO' },
  { title: 'Music Player', description: 'Minimalist audio player with playlist, shuffle, repeat and visualizer. Supports all common audio formats and runs completely without installation.', link: 'https://kodinitools.com/ultimativermusikplayer/', svg: '/image/musikplayer-en.svg', i18nKey: 'tools.musicPlayer', badge: 'New' },
  { title: 'Audio Visualizer', description: 'Create stunning MP4 videos for TikTok, Instagram and YouTube. Choose from various visualization styles and export in HD quality.', link: 'https://kodinitools.com/visualizer/', svg: '/image/audiovisualizer-en.svg', i18nKey: 'tools.audioVisualizer', badge: 'Video' },
  { title: 'MP3 Converter', description: 'Convert audio files quickly and easily to MP3 format. Adjustable bitrate and metadata support optimized for podcasts and music.', link: 'https://kodinitools.com/mp3konverter/', svg: '/image/mp3-converter.svg', i18nKey: 'tools.mp3Converter', badge: 'MP3' },
  { title: 'Interactive Audio Equalizer', description: 'Edit your audio files with an intuitive graphical equalizer. Real-time preview and direct export to all common audio formats.', link: 'https://kodinitools.com/audioequalizer/', svg: '/image/interaktiver-equalizer-en.svg', i18nKey: 'tools.interactiveEqualizer', badge: 'EQ' },
  { title: 'Modern Music Player', description: 'Sleek and modern audio player with all essential features. Elegant interface with playlist support and a customizable appearance.', link: 'https://kodinitools.com/modernermusikplayer/', svg: '/image/modern-music-player.svg', i18nKey: 'tools.modernPlayer', badge: 'Player' },
  { title: 'Audio Playlist Generator', description: 'Automatically create playlists from your audio files. Smart sorting, filter options and direct export as M3U, XSPF or JSON file.', link: 'https://kodinitools.com/playlist_generator/', svg: '/image/audio-playlist-generator.svg', i18nKey: 'tools.playlistGenerator', badge: 'Playlist' },
  { title: 'Alarm Tool', description: 'Reliable alarm tool for reminders and alarms. Use custom audio files as your ringtone – works even with a locked screen.', link: 'https://kodinitools.com/alarmtool/', svg: '/image/modern-alarmtool.svg', i18nKey: 'tools.alarmTool', badge: 'Alarm' },
  { title: 'Audio Normalizer', description: 'Normalize the volume of your audio files automatically. Ideal for podcasts and audiobooks with a consistent volume level across all tracks.', link: 'https://kodinitools.com/audionormalisierer/', svg: '/image/audio-normalizer-en.svg', i18nKey: 'tools.audioNormalizer', badge: 'Normalize' },
  { title: 'Playlist to WebM or MP3 Converter', description: 'Convert up to 50 audio tracks into a WebM or MP3 playlist – perfect for YouTube and podcasts. No additional software required.', link: 'https://kodinitools.com/playlistkonverter/', svg: '/image/playlist-converter.svg', i18nKey: 'tools.playlistToWebm', badge: 'WebM·MP3' }
]

const imageTools = [
  { title: 'Image Converter', description: 'Convert images between JPG, PNG, WebP, AVIF, GIF and BMP. Individual quality settings and batch processing for up to 100 files at once.', link: 'https://kodinitools.com/bildkonverter/', svg: '/image/image-converter.svg', i18nKey: 'imageTools.imageConverter', badge: 'Multi' },
  { title: 'Batch Image Editor', description: 'Edit 100+ images simultaneously: resize, rename, export as ZIP or PDF. Saves hours of manual work – all changes processed securely in the browser.', link: 'https://kodinitools.com/bilderseriebearbeiten/', svg: '/image/batch-imageeditor.svg', i18nKey: 'imageTools.batchImageEditor', badge: 'Batch' },
  { title: 'Photo Collage', description: 'Create creative photo collages from your images. Various layouts, frames and templates for professional results in seconds.', link: 'https://kodinitools.com/collagemaker', svg: '/image/photocollage.svg', i18nKey: 'imageTools.photoCollage', badge: 'Creative' }
]

const diverseTools = [
  { title: 'Kodini Color Extractor', description: 'Extract dominant colors from images. Export color palettes as HEX, RGB or CSS variables for your next design project.', link: 'https://kodinitools.com/kodini-color-extractor/', svg: '/image/collor-extractor.svg', i18nKey: 'diverseTools.colorExtractor', badge: 'Colors' },
  { title: 'Video Converter', description: 'Convert videos to various formats. Supports MP4, WebM, AVI, MOV and more – directly in the browser without upload limits.', link: 'https://kodinitools.com/videokonverter/', svg: '/image/video-converter.svg', i18nKey: 'diverseTools.videoConverter', badge: 'Video' }
]

const features = [
  { text: '100% Free', i18nKey: 'hero.features.free' },
  { text: 'Privacy First', i18nKey: 'hero.features.privacy' },
  { text: 'Browser-based', i18nKey: 'hero.features.browserBased' },
  { text: 'Server-based', i18nKey: 'hero.features.serverBased' },
  { text: 'Multi-Language', i18nKey: 'hero.features.multiLanguage' },
  { text: 'No Installation', i18nKey: 'hero.features.noInstall' }
]
---

<EnLayout>
  <div id="app">
    <!-- Global Background Effects -->
    <div class="global-background">
      <div class="global-gradient"></div>
      <div class="global-noise"></div>
      <div class="mouse-spotlight" id="mouseSpotlight"></div>
    </div>

    <!-- Global Floating Tool Icons Background -->
    <div class="floating-icons-global" id="floatingIcons">
      <div class="floating-icon icon-1">
        <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 20h5v-10h5v20h5v-15h5v10h5v-5h5v10h5v-15h5v20h5v-10h5v5h5v-8h5"/>
        </svg>
      </div>
      <div class="floating-icon icon-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <div class="floating-icon icon-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="21" x2="4" y2="14"/>
          <line x1="9" y1="21" x2="9" y2="8"/>
          <line x1="14" y1="21" x2="14" y2="12"/>
          <line x1="19" y1="21" x2="19" y2="5"/>
        </svg>
      </div>
      <div class="floating-icon icon-5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </div>
      <div class="floating-icon icon-7">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M15.54 8.46a5 5 0 010 7.07"/>
          <path d="M19.07 4.93a10 10 0 010 14.14"/>
        </svg>
      </div>
      <div class="floating-icon icon-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2v4h12v12h4"/>
          <path d="M18 22v-4H6V6H2"/>
        </svg>
      </div>
      <div class="floating-icon icon-9">
        <svg viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 20h5v-10h5v20h5v-15h5v10h5v-5h5v10h5v-15h5v20h5v-10h5v5h5v-8h5"/>
        </svg>
      </div>
      <div class="floating-icon icon-10">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <div class="floating-icon icon-11">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
      </div>
      <div class="floating-icon icon-12">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="21" x2="4" y2="14"/>
          <line x1="9" y1="21" x2="9" y2="8"/>
          <line x1="14" y1="21" x2="14" y2="12"/>
          <line x1="19" y1="21" x2="19" y2="5"/>
        </svg>
      </div>
    </div>

    <!-- Navigation (SSI Partial) -->
    <Fragment set:html={navHtml} />

    <!-- Hero Section with Animated Mesh Gradient -->
    <section class="hero">
      <div class="mesh-gradient-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
        <div class="mesh-blob mesh-blob-4"></div>
      </div>
      <div class="noise-overlay"></div>

      <div class="hero-content">
        <div class="hero-promo">
          <div class="hero-logo">
            <img src="https://kodinitools.com/images/logo.svg" alt="KodiniTools Logo" />
          </div>
          <h1 class="hero-title typing-title">
            <span class="typed-text" id="typedText"></span>
          </h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">Secure editing - In browser or on our servers<br/>No installation, no registration</p>
        </div>

        <!-- Features Grid -->
        <div class="features-grid">
          {features.map((feature) => (
            <div class="feature-card">
              <div class="feature-text" data-i18n={feature.i18nKey}>{feature.text}</div>
            </div>
          ))}
        </div>

        <!-- Spotlight Search Box -->
        <div class="search-container">
          <div class="search-box spotlight-search">
            <svg class="search-icon-svg" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input
              type="text"
              id="searchInput"
              placeholder="Search tools..."
              data-i18n-placeholder="search.placeholder"
              class="search-input"
            />
            <kbd class="search-kbd" id="searchKbd">&#x2318;K</kbd>
            <button
              id="searchClear"
              class="search-clear"
              aria-label="Clear search"
              data-i18n-aria="search.clear"
              style="display: none;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Search Results Section (hidden by default, shown via JS) -->
    <section id="searchResults" class="tools-section search-results-section" style="display: none;">
      <div class="section-header">
        <h2 data-i18n="search.resultsTitle">Search Results</h2>
        <p id="searchResultsCount"></p>
      </div>
      <div id="searchResultsGrid" class="svg-card-grid"></div>
    </section>

    <!-- Favorites Section (hidden until at least one favorite is saved) -->
    <section id="favoritesSection" class="tools-section favorites-section" style="display: none;">
      <div class="section-header">
        <h2 data-i18n="favorites.sectionTitle">My Favorites</h2>
        <button id="favClearAll" class="fav-clear-btn" data-i18n="favorites.clearAll">Remove all</button>
      </div>
      <div id="favoritesGrid" class="svg-card-grid"></div>
    </section>

    <!-- Audio Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="tools.sectionTitle">Audio Tools</h2>
      </div>

      <div class="section-video-wrapper">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="section-video"
        >
          <source src="/videos/audio-tools.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="svg-card-grid">
        {audioTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-en={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <p class="tool-card-desc">{tool.description}</p>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Add to favorites" title="Favorite">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Open
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="imageTools.sectionTitle">Image Tools</h2>
      </div>

      <div class="section-video-wrapper">
        <video
          muted
          loop
          playsinline
          preload="none"
          class="section-video lazy-video"
        >
          <source src="/videos/image-tools.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="svg-card-grid grid-centered">
        {imageTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-en={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <p class="tool-card-desc">{tool.description}</p>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Add to favorites" title="Favorite">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Open
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Diverse Tools Section -->
    <section class="tools-section">
      <div class="section-header">
        <h2 data-i18n="diverseTools.sectionTitle">Diverse Tools</h2>
      </div>

      <div class="section-video-wrapper">
        <video
          muted
          loop
          playsinline
          preload="none"
          class="section-video lazy-video"
        >
          <source src="/videos/diverse-tools.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="svg-card-grid grid-centered">
        {diverseTools.map((tool) => (
          <a href={tool.link} class="svg-card-link" data-title={tool.title} data-description={tool.description} data-svg-en={tool.svg} data-i18n-key={tool.i18nKey}>
            <div class="tool-card">
              {tool.badge && <span class="tool-card-badge">{tool.badge}</span>}
              <h3 class="tool-card-title">{tool.title}</h3>
              <p class="tool-card-desc">{tool.description}</p>
              <div class="tool-card-footer">
                <button class="fav-btn" aria-label="Add to favorites" title="Favorite">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
                <span class="tool-card-open" data-i18n="tool.open">Open
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
            <div class="tool-popup" role="tooltip">
              <p class="tool-popup-desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Scroll to Top Button -->
    <button
      id="scrollToTop"
      class="scroll-to-top"
      aria-label="Scroll to top"
      data-i18n-aria="search.scrollTop"
      style="display: none;"
    >
      &uarr;
    </button>

    <!-- Footer (SSI Partial) -->
    <Fragment set:html={footerHtml} />

    <!-- Cookie Banner (SSI Partial) -->
    <Fragment set:html={cookieBannerHtml} />
  </div>

  <!-- Minimal Vanilla JS for interactivity -->
  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // --- Page i18n ---
    var PAGE_I18N = {
      de: {
        'hero.title': 'Kostenlose Online-Tools f\u00fcr Audio & Bild',
        'hero.subtitle': 'Sichere Bearbeitung - Im Browser oder auf unseren Servern\nKeine Installation, keine Anmeldung',
        'hero.features.free': '100% Kostenlos',
        'hero.features.privacy': 'Datenschutz',
        'hero.features.browserBased': 'Browser-basiert',
        'hero.features.serverBased': 'Server-basiert',
        'hero.features.multiLanguage': 'Mehrsprachig',
        'hero.features.noInstall': 'Keine Installation',
        'search.placeholder': 'Tools durchsuchen...',
        'search.clear': 'Suche l\u00f6schen',
        'search.resultsTitle': 'Suchergebnisse',
        'search.resultsFound': 'Tools gefunden',
        'search.noResults': 'Keine Tools gefunden. Versuchen Sie einen anderen Suchbegriff.',
        'search.scrollTop': 'Nach oben scrollen',
        'favorites.sectionTitle': 'Meine Favoriten',
        'favorites.clearAll': 'Alle entfernen',
        'tool.open': 'Öffnen',
        'processing.browser': 'Browser',
        'processing.server': 'Server',
        'tools.sectionTitle': 'Audio Tools',
        'tools.sectionDescription': 'Bearbeiten Sie Ihre Audiodateien sicher - einige Tools laufen im Browser, andere auf unseren Hostinger-Servern',
        'tools.audioConverter.title': 'Audio Konverter',
        'tools.audioConverter.description': 'Konvertieren Sie Audio zwischen MP3, WAV, OGG, FLAC, AAC und M4A. Stapelverarbeitung mit Qualit\u00e4tsauswahl.',
        'tools.audioConverter.badge': 'Batch',
        'tools.audioConverter.svg': '/image/audio-konverter.svg',
        'tools.audioEqualizer.title': '19-Band EQ Pro',
        'tools.audioEqualizer.description': '19-Band Equalizer mit Dynamic Compressor, Presets und Aufnahme-Funktion.',
        'tools.audioEqualizer.badge': 'PRO',
        'tools.audioEqualizer.svg': '/image/eq19-pro.svg',
        'tools.musicPlayer.title': 'Musikplayer',
        'tools.musicPlayer.description': 'Minimalistischer Audioplayer mit Playlist, Shuffle, Repeat und Visualizer-Funktion.',
        'tools.musicPlayer.badge': 'Neu',
        'tools.musicPlayer.svg': '/image/musikplayer.svg',
        'tools.audioVisualizer.title': 'Audio Visualizer',
        'tools.audioVisualizer.description': 'Erstellen Sie beeindruckende MP4-Videos f\u00fcr TikTok, Instagram und YouTube mit Audio-Visualisierungen.',
        'tools.audioVisualizer.badge': 'Video',
        'tools.audioVisualizer.svg': '/image/audio-visualizer.svg',
        'tools.mp3Converter.title': 'MP3 Konverter',
        'tools.mp3Converter.description': 'Konvertieren Sie Audiodateien schnell und einfach in das MP3-Format. Optimiert f\u00fcr Podcasts und Musik.',
        'tools.mp3Converter.badge': 'MP3',
        'tools.mp3Converter.svg': '/image/mp3-konverter.svg',
        'tools.interactiveEqualizer.title': 'Interaktiver Audio Equalizer',
        'tools.interactiveEqualizer.description': 'Bearbeiten Sie Ihre Audiodateien mit einem intuitiven grafischen Equalizer. Echtzeit-Vorschau und Export.',
        'tools.interactiveEqualizer.badge': 'Interaktiv',
        'tools.interactiveEqualizer.svg': '/image/interaktiver-equalizer.svg',
        'tools.modernPlayer.title': 'Moderner Musikplayer',
        'tools.modernPlayer.description': 'Schlanker und moderner Audio-Player mit allen wichtigen Funktionen. Unterst\u00fctzt viele Formate.',
        'tools.modernPlayer.badge': 'Modern',
        'tools.modernPlayer.svg': '/image/moderner-musikplayer.svg',
        'tools.playlistGenerator.title': 'Audioplaylist Generator',
        'tools.playlistGenerator.description': 'Erstellen Sie automatisch Playlists aus Ihren Audiodateien. Mit Sortier- und Filterfunktionen.',
        'tools.playlistGenerator.badge': 'Playlist',
        'tools.playlistGenerator.svg': '/image/playlist-generator.svg',
        'tools.alarmTool.title': 'Alarmtool',
        'tools.alarmTool.description': 'Zuverl\u00e4ssiges Alarm-Tool f\u00fcr Erinnerungen und Wecker. Mit individuellen Audio-Dateien.',
        'tools.alarmTool.badge': 'Alarm',
        'tools.alarmTool.svg': '/image/alarmtool.svg',
        'tools.audioNormalizer.title': 'Audio Normalizer',
        'tools.audioNormalizer.description': 'Normalisieren Sie die Lautst\u00e4rke Ihrer Audiodateien automatisch. Perfekt f\u00fcr Podcasts und H\u00f6rb\u00fccher.',
        'tools.audioNormalizer.badge': 'Normalizer',
        'tools.audioNormalizer.svg': '/image/audio-normalizer.svg',
        'tools.playlistToWebm.title': 'Playlist zu WebM Konverter',
        'tools.playlistToWebm.description': 'Bis zu 50 Audio-Tracks in eine WebM-Datei konvertieren',
        'tools.playlistToWebm.badge': 'WebM',
        'tools.playlistToWebm.svg': '/image/playlist-konverter.svg',
        'imageTools.sectionTitle': 'Bild Tools',
        'imageTools.sectionDescription': 'Konvertieren und bearbeiten Sie Ihre Bilder sicher - einige Tools laufen im Browser, andere auf unseren Hostinger-Servern',
        'imageTools.imageConverter.title': 'Bildkonverter',
