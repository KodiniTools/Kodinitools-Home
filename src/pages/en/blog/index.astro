---
import GlobalNav from '../../../components/GlobalNav.astro'
import TickerBar from '../../../components/TickerBar.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import SiteFont from '../../../components/SiteFont.astro'
import { readFileSync } from 'fs'
import { resolve } from 'path'

const cookieBannerHtml = readFileSync(resolve('public/partials/cookie-banner.html'), 'utf-8')

const posts = [
  {
    slug: '/en/blog/end-of-subscription-madness/',
    title: 'No More Subscription Madness: Why KodiniTools Chooses Freedom Over Paywalls',
    description: 'The philosophy behind KodiniTools: free, unrestricted tools instead of forced subscriptions — funded by voluntary donations instead of rigid paywalls.',
    date: 'June 25, 2026',
    tag: 'Philosophy',
    minutes: 4,
    featured: true,
    image: '/image/kodinitools-blog.webp',
  },
  {
    slug: '/en/blog/visualizer-effects/',
    title: 'Visualizer Effects: 130+ Audio Visualizations, Multi-Layer & Beat Reactions in Your Browser',
    description: 'GPU effects from bars to light rays to mandalas, portrait effects for your own images, multiple layers with blend modes, beat punch and onset reactions — free, no upload.',
    date: 'September 21, 2026',
    tag: 'Video',
    minutes: 7,
    image: '/image/visualizer-blog-3.png',
    newTab: true,
  },
  {
    slug: '/en/blog/watermark-multiple-images/',
    title: 'Watermark Multiple Images at Once: Protect Hundreds of Photos in One Pass',
    description: 'Set a text watermark with font, size, color, opacity, rotation and position once, check it live on all selected images and export as ZIP — no upload.',
    date: 'September 20, 2026',
    tag: 'Image',
    minutes: 5,
    image: '/image/watermark-blog-en.png',
    newTab: true,
  },
  {
    slug: '/en/blog/cut-audio-online/',
    title: 'Cut Audio Online: Trim & Export with Millisecond Precision',
    description: 'Set start and end via waveform or millisecond input, fade-in and fade-out, preview, cut repeatedly and export as WAV — no upload.',
    date: 'September 19, 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/audiocutter-blog-en.png',
    newTab: true,
  },
  {
    slug: '/en/blog/ultimate-music-player/',
    title: 'Ultimate Music Player: Play Local Music in Your Browser with a Visualizer',
    description: 'Load files or whole folders via drag and drop, playlist with shuffle and repeat, LED equalizer visualizer, all common audio formats — no upload.',
    date: 'September 18, 2026',
    tag: 'Audio',
    minutes: 4,
    image: '/image/ultimativermusikplayer-blog-en.png',
    newTab: true,
  },
  {
    slug: '/en/blog/alarm-tool-custom-alarm-sound/',
    title: 'Alarm Tool: Create and Record Your Own Alarm Sound with Oscillators',
    description: 'Design alarm and signal tones from up to 12 oscillators, set waveform, frequency, envelope and filter, save as a preset and record — in your browser.',
    date: 'September 17, 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/alarmtool-blog-en.png',
  },
  {
    slug: '/en/blog/color-extractor-palette-generator/',
    title: 'Extract Colors from an Image & Generate a Color Palette: Free in Your Browser',
    description: 'Read the dominant colors of any image as HEX or RGB, adjust the image live and create harmonious palettes with the spacebar — no upload.',
    date: 'September 16, 2026',
    tag: 'Image',
    minutes: 6,
    image: '/image/farbextraktor-blog-en.png',
  },
  {
    slug: '/en/blog/19-band-equalizer/',
    title: 'Online Equalizer: Use a 19-Band EQ with Compressor Free in Your Browser',
    description: '19 frequency bands from 20 Hz to 20 kHz, presets for rock, pop and podcast, dynamic compressor, level meter and export as WAV or WebM — no upload.',
    date: 'September 16, 2026',
    tag: 'Audio',
    minutes: 6,
    image: '/image/audio-equalizer19-blog-en.png',
  },
  {
    slug: '/en/blog/online-text-editor/',
    title: 'Online Text Editor: Write, Format & Export Text Without Installing Anything',
    description: 'Write, format, insert images, Markdown preview, word counter, print and save — free in your browser, no upload.',
    date: 'September 16, 2026',
    tag: 'Text',
    minutes: 5,
    image: '/image/texteditor-en.png',
  },
  {
    slug: '/en/blog/create-playlist-m3u/',
    title: 'How to Create a Playlist: Generate M3U, PLS & XSPF Free in Your Browser',
    description: 'Add audio files, set the order, save as M3U, M3U8, PLS, XSPF, CUE, CSV or JSON — no upload, directly in your browser.',
    date: 'September 15, 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/playlist-generator.png',
  },
  {
    slug: '/en/blog/change-audio-file-format/',
    title: 'How to Change Audio File Format: GDPR-Compliant & Free',
    description: 'MP3, WAV, OGG, FLAC, AAC — which format for what? And what does GDPR-compliant mean for audio converters?',
    date: 'June 20, 2026',
    tag: 'Audio',
