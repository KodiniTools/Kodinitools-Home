    slug: '/en/blog/normalize-audio-online/',
    title: 'How to Normalize Audio: LUFS & dBFS Explained',
    description: 'Spotify -14 LUFS, Podcasts -16 LUFS, Broadcasting -23 LUFS — which standard applies when?',
    date: 'June 8, 2026',
    tag: 'Audio',
    minutes: 5,
    image: '/image/normalieser-blog-en.png',
  },
  {
    slug: '/en/blog/music-video-tiktok-free/',
    title: 'How to Create a Music Video for TikTok Free (No App)',
    description: 'Use the Audio Visualizer in your browser — MP4 export in vertical 9:16 format for TikTok and Reels.',
    date: 'June 11, 2026',
    tag: 'Video',
    minutes: 4,
    image: '/image/visualizer-blog-en.png',
  },
  {
    slug: '/en/blog/batch-resize-images/',
    title: 'How to Resize Multiple Images at Once: Batch Editing Made Easy',
    description: 'Scale 100+ images in seconds, rename and export as ZIP — without installing any software.',
    date: 'June 14, 2026',
    tag: 'Image',
    minutes: 4,
    image: '/image/bilderserie-blog-en.png',
  },
  {
    slug: '/en/blog/photo-collage-free-online/',
    title: 'How to Create a Photo Collage Free Online Without an App',
    description: 'Layouts for Instagram, Pinterest and printing. Images never leave your browser — GDPR compliant.',
    date: 'June 17, 2026',
    tag: 'Image',
    minutes: 4,
    image: '/image/collagemaker-blog-en.png',
  },
]

const featuredPost = posts.find((post) => post.featured)
const regularPosts = posts.filter((post) => !post.featured)
// Ab dieser Anzahl Beiträge in der Liste wird die Liste im Panel scrollbar
// (sichtbar bleiben 4 Karten, siehe .blog-grid-scroll und das Script unten).
const SCROLL_FROM_POSTS = 5
const isGridScrollable = regularPosts.length >= SCROLL_FROM_POSTS
---

<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);} // eslint-disable-line prefer-rest-params -- offizielles Google-Snippet, arguments bewusst
  gtag('consent', 'default', {
    'ad_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied',
    'analytics_storage': 'denied', 'functionality_storage': 'denied',
    'personalization_storage': 'denied', 'security_storage': 'granted', 'wait_for_update': 500
  });
  (function() {
    try {
      const c = JSON.parse(localStorage.getItem('cookieConsent') || '{}');
      if (c.analytics) gtag('consent', 'update', { 'analytics_storage': 'granted', 'functionality_storage': 'granted', 'personalization_storage': 'granted' });
      if (c.marketing) gtag('consent', 'update', { 'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted' });
    } catch { /* Consent optional – Fehler bewusst ignorieren */ }
  })();
  </script>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-T7NS656K');</script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog – How-to Guides for Audio & Image Editing | KodiniTools</title>
  <meta name="description" content="How-to guides for free online tools: JPG to WebP, normalize audio, create TikTok videos and more — GDPR compliant, no registration." />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="en" />
  <link rel="canonical" href="https://kodinitools.com/en/blog/" />
  <link rel="alternate" hreflang="en" href="https://kodinitools.com/en/blog/" />
  <link rel="alternate" hreflang="de" href="https://kodinitools.com/blog/" />
  <link rel="alternate" hreflang="x-default" href="https://kodinitools.com/blog/" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kodinitools.com/en/blog/" />
  <meta property="og:title" content="Blog – How-to Guides for Audio & Image Editing | KodiniTools" />
  <meta property="og:description" content="How-to guides for free online tools: convert audio, optimize images, create TikTok videos and more." />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="KodiniTools" />

  <meta name="theme-color" content="#014f99" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <style>
    @import '../../../styles/global.css';

    .blog-index-main {
      min-height: calc(100vh - 140px);
      padding: 2rem 1rem 5rem;
    }
    .blog-index-container { max-width: 800px; margin: 0 auto; }
    .blog-breadcrumb {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.82rem; color: var(--text-muted, #4f6f8e); margin-bottom: 2rem;
    }
    .blog-breadcrumb a { color: var(--primary-color, #014f99); text-decoration: none; }
    .blog-breadcrumb a:hover { text-decoration: underline; }
    .blog-index-header { text-align: center; margin-bottom: 3rem; }
    .blog-index-header h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      margin-bottom: 0.75rem; line-height: 1.2;
    }
    [data-theme="dark"] .blog-index-header h1 {
      background: linear-gradient(135deg, #c9984d 0%, #f8e1a9 100%);
      -webkit-background-clip: text; background-clip: text;
    }
    .blog-index-subtitle { font-size: 1rem; color: var(--text-secondary, #014f99); max-width: 520px; margin: 0 auto; }
    /* Content panel: keeps text readable on the animated global background (watermark, grid) */
    .blog-panel {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1.1rem;
      padding: clamp(1.25rem, 4vw, 2.25rem);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }

    [data-theme="dark"] .blog-panel {
      background: rgba(14, 28, 50, 0.92);
    }

    .blog-grid { display: flex; flex-direction: column; gap: 1rem; }

    /* Ab 5 Beiträgen scrollt die Liste innerhalb des Panels. Die sichtbare Höhe
       (4 Karten + kleiner Anriss der 5.) setzt das Script unten als CSS-Variable;
       70vh ist der Fallback ohne JavaScript. */
    .blog-grid-scroll {
      max-height: var(--blog-grid-max-height, 70vh);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--primary-color, #014f99) transparent;
      /* Innenabstand + negativer Rand: Hover-Schatten und Rahmen werden nicht abgeschnitten */
      padding: 0.25rem 0.75rem 0.25rem 0.25rem;
      margin: -0.25rem;
    }

    /* Karten dürfen im begrenzten Flex-Container nicht zusammengedrückt werden */
    .blog-grid-scroll > * {
      flex-shrink: 0;
    }

    [data-theme="dark"] .blog-grid-scroll {
      scrollbar-color: var(--primary-color, #e8a945) transparent;
    }

    @media (prefers-reduced-motion: no-preference) {
      .blog-grid-scroll { scroll-behavior: smooth; }
    }
    .blog-featured-card {
      display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: 0;
      background: var(--bg-secondary, #ffffff); border: 1px solid var(--border-color, #d4c09a);
      border-radius: 1.1rem; overflow: hidden; text-decoration: none; margin-bottom: 1.5rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .blog-featured-card:hover {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 8px 28px rgba(1, 79, 153, 0.14); text-decoration: none;
    }
    [data-theme="dark"] .blog-featured-card:hover { border-color: var(--primary-color, #e8a945); box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35); }
    .blog-featured-media { min-height: 180px; }
    .blog-featured-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .blog-featured-content { padding: 1.5rem 1.75rem; display: flex; flex-direction: column; justify-content: center; }
    .blog-featured-content h2 { font-size: 1.2rem; font-weight: 800; color: var(--text-color, #003971); margin: 0 0 0.5rem; line-height: 1.3; }
    [data-theme="dark"] .blog-featured-content h2 { color: var(--text-color, #f9f2d5); }

    /* Description inside image cards: explicit color, otherwise the browser link color of the <a> wrapper leaks through */
    .blog-featured-content p {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--text-secondary, #4f6f8e);
      margin: 0;
    }

    [data-theme="dark"] .blog-featured-content p { color: var(--text-secondary, #f8e1a9); }
    .blog-card-tag-featured { background: linear-gradient(135deg, #014f99 0%, #003971 100%); color: #ffffff; }
    [data-theme="dark"] .blog-card-tag-featured { background: linear-gradient(135deg, #c9984d 0%, #a67d3d 100%); color: #091428; }
    @media (max-width: 640px) {
      .blog-featured-card { grid-template-columns: 1fr; }
      .blog-featured-media { min-height: 160px; }
    }
    /* Regular post with image preview (same layout as featured card, sits inside the grid) */
    .blog-featured-card.blog-card-image {
      margin-bottom: 0;
      border-radius: 1rem;
    }

    .blog-card {
      display: block; background: var(--bg-secondary, #ffffff);
      border: 1px solid var(--border-color, #d4c09a); border-radius: 1rem;
      padding: 1.25rem 1.5rem; text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .blog-card:hover {
      border-color: var(--primary-color, #014f99);
      box-shadow: 0 4px 20px rgba(1, 79, 153, 0.1); text-decoration: none;
    }
    [data-theme="dark"] .blog-card:hover { border-color: var(--primary-color, #e8a945); box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
    .blog-card-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
    .blog-card-tag {
      font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px;
      color: var(--primary-color, #014f99); background: rgba(1,79,153,0.08);
    }
    [data-theme="dark"] .blog-card-tag { background: rgba(201,152,77,0.12); color: var(--primary-color, #e8a945); }
    .blog-card-meta { font-size: 0.78rem; color: var(--text-muted, #4f6f8e); }
    .blog-card h2 { font-size: 1rem; font-weight: 700; color: var(--text-color, #003971); margin: 0 0 0.4rem; line-height: 1.35; }
    [data-theme="dark"] .blog-card h2 { color: var(--text-color, #f9f2d5); }
    .blog-card p { font-size: 0.85rem; line-height: 1.6; color: var(--text-secondary, #4f6f8e); margin: 0; }
    .blog-card-arrow {
      display: flex; align-items: center; justify-content: flex-end;
      margin-top: 0.75rem; color: var(--primary-color, #014f99);
      font-size: 0.8rem; font-weight: 600; gap: 0.3rem;
    }
    [data-theme="dark"] .blog-card-arrow { color: var(--primary-color, #e8a945); }
    /* Back-to-top button below the post list */
    /* „Nach oben" steht normal unter der Liste. Sobald diese Stelle aus dem
       Viewport rutscht, dockt der Button unten rechts an (Script unten), damit er
       beim Scrollen der Liste und der Seite immer erreichbar bleibt. Der Wrapper
       behält seine Höhe (min-height per Script), damit das Layout nicht springt.
       position: sticky ist hier keine Option, weil body site-weit overflow-x: hidden
       hat und damit zum Scroll-Container wird. */
    .blog-top {
      margin-top: 2.5rem;
      text-align: center;
    }

    .blog-top-btn.is-docked {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 900; /* über Inhalt, unter Cookie-Banner (10000) */
    }

    @media (max-width: 600px) {
      .blog-top-btn.is-docked {
        right: 0.9rem;
        bottom: 0.9rem;
      }
    }

    .blog-top-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.4rem;
      background: linear-gradient(135deg, #014f99 0%, #003971 100%);
      color: #ffffff;
      border: none;
      border-radius: 0.75rem;
      font-family: inherit;
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 15px rgba(1, 79, 153, 0.3);
    }

    [data-theme="dark"] .blog-top-btn {
      background: linear-gradient(135deg, #c9984d 0%, #a67d3d 100%);
      color: #091428;
      box-shadow: 0 4px 15px rgba(201, 152, 77, 0.3);
    }

    .blog-top-btn:hover,
    .blog-top-btn:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(1, 79, 153, 0.4);
    }

    [data-theme="dark"] .blog-top-btn:hover,
    [data-theme="dark"] .blog-top-btn:focus-visible {
      box-shadow: 0 6px 20px rgba(201, 152, 77, 0.4);
    }

    @media (max-width: 600px) {
      .blog-index-main { padding: 1.5rem 0.75rem 3rem; }
      .blog-panel { padding: 1rem 0.9rem; border-radius: 0.9rem; }
      .blog-card { padding: 1rem 1.1rem; }
    }
  </style>
  <SiteFont />
</head>
<body>
  <div class="global-background" aria-hidden="true">
    <div class="global-gradient"></div>
    <div class="global-noise"></div>
  </div>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T7NS656K" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <GlobalNav lang="en" />
  <TickerBar lang="en" />

  <main class="blog-index-main">
    <div class="blog-index-container">

      <nav class="blog-breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Blog</span>
      </nav>

      <div class="blog-panel">

      <header class="blog-index-header">
        <h1>Blog – Tips &amp; How-to Guides</h1>
        <p class="blog-index-subtitle">Step-by-step guides for audio and image editing — free, GDPR compliant, no registration required.</p>
      </header>

      {featuredPost && (
        <a href={featuredPost.slug} class="blog-featured-card">
          <div class="blog-featured-media">
            <img src={featuredPost.image} alt="" width="640" height="360" loading="lazy" />
          </div>
          <div class="blog-featured-content">
            <div class="blog-card-header">
              <span class="blog-card-tag blog-card-tag-featured">{featuredPost.tag}</span>
              <span class="blog-card-meta">{featuredPost.date} · {featuredPost.minutes} min read</span>
            </div>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.description}</p>
            <div class="blog-card-arrow">
              Read article
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      )}

      <div class:list={['blog-grid', { 'blog-grid-scroll': isGridScrollable }]}>
        {regularPosts.map((post) =>
          post.image ? (
            <a href={post.slug} class="blog-featured-card blog-card-image" target={post.newTab ? '_blank' : undefined} rel={post.newTab ? 'noopener' : undefined}>
              <div class="blog-featured-media">
                <img src={post.image} alt="" width="640" height="360" loading="lazy" />
              </div>
              <div class="blog-featured-content">
                <div class="blog-card-header">
                  <span class="blog-card-tag">{post.tag}</span>
                  <span class="blog-card-meta">{post.date} · {post.minutes} min read</span>
                </div>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <div class="blog-card-arrow">
                  Read article
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          ) : (
            <a href={post.slug} class="blog-card">
              <div class="blog-card-header">
                <span class="blog-card-tag">{post.tag}</span>
                <span class="blog-card-meta">{post.date} · {post.minutes} min read</span>
              </div>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <div class="blog-card-arrow">
                Read article
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </a>
          )
        )}
      </div>

      </div>

      <div class="blog-top">
        <button type="button" class="blog-top-btn" id="blogScrollTop" aria-label="Scroll to top of page">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>
          </svg>
          Back to top
        </button>
      </div>

    </div>
  </main>

  <SiteFooter lang="en" />
  <Fragment set:html={cookieBannerHtml} />

  <script is:inline>
  (function() {
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
  </script>

  <script is:inline>
  (function() {
    const grid = document.querySelector('.blog-grid-scroll');
    const btn = document.getElementById('blogScrollTop');

    // Sichtbare Höhe der scrollbaren Liste: genau 4 Karten plus ein kleiner
    // Anriss der 5. Karte als Hinweis, dass weitere Beiträge folgen.
    const VISIBLE_CARDS = 4;
    const PEEK_PX = 40;

    function applyGridHeight() {
      if (!grid) return;
      const cards = grid.children;
      if (cards.length <= VISIBLE_CARDS) {
        grid.style.removeProperty('--blog-grid-max-height');
        return;
      }
      const first = cards[0].getBoundingClientRect();
      const last = cards[VISIBLE_CARDS - 1].getBoundingClientRect();
      const cs = window.getComputedStyle(grid);
      const padding = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
      const height = Math.round(last.bottom - first.top + padding + PEEK_PX);
      if (height > 0) grid.style.setProperty('--blog-grid-max-height', height + 'px');
    }

    if (grid) {
      applyGridHeight();
      window.addEventListener('load', applyGridHeight);
      window.addEventListener('resize', applyGridHeight, { passive: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(applyGridHeight);
    }

    // Andocken: Wrapper (.blog-top) beobachten; ist er nicht im Viewport, wird der
    // Button fixiert unten rechts angezeigt, sonst steht er normal unter der Liste.
    const wrap = btn ? btn.parentElement : null;
    if (btn && wrap && 'IntersectionObserver' in window) {
      wrap.style.minHeight = btn.offsetHeight + 'px';
      const observer = new IntersectionObserver(function(entries) {
        btn.classList.toggle('is-docked', !entries[0].isIntersecting);
      }, { threshold: 0 });
      observer.observe(wrap);
    }

    if (btn) {
      btn.addEventListener('click', function() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const behavior = reduce ? 'auto' : 'smooth';
        if (grid) grid.scrollTo({ top: 0, behavior });
        window.scrollTo({ top: 0, behavior });
      });
    }
  })();
  </script>
</body>
</html>
