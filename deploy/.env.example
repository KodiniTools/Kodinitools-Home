# Vorlage für /opt/kodini/.env (Server, chmod 600, NICHT ins Git committen).
# Wird von der systemd-Unit kodini-admin.service via EnvironmentFile geladen.
# Der eigentliche Admin-Dienst, der diese Werte nutzt, entsteht in Phase 3.

# --- Netzwerk ---
PORT=9020

# --- Auth (ein Inhaber-Konto) ---
# Passwort-Hash (argon2id oder bcrypt). NIE das Klartext-Passwort speichern.
# Hash erzeugen z. B. mit:  node -e "import('argon2').then(a=>a.hash(process.argv[1])).then(console.log)" 'DEIN-PASSWORT'
ADMIN_PASSWORD_HASH=

# Zufälliges Secret zum Signieren der Session-Cookies (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional: TOTP-Secret für 2FA (Phase 5)
# ADMIN_TOTP_SECRET=

# --- Pfade ---
REPO_DIR=/opt/kodini/repo
WEBROOT=/var/www/kodinitools.com
UPLOADS_DIR=/var/www/kodinitools.com/uploads

# --- Git-Push (SSH-Deploy-Key, siehe deploy/README.md) ---
GIT_BRANCH=main
GIT_REMOTE=origin

# --- Upload-Limits ---
MAX_UPLOAD_MB=2048
