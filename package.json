{
  "name": "kodini-tools-astro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "astro build && vitest run tests/smoke",
    "typecheck": "astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@astrojs/vue": "5.1.4",
    "astro": "^5.17.2",
    "js-yaml": "^4.1.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^16.0.0",
    "happy-dom": "20.14.5",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
